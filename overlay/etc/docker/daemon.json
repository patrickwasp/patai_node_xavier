{
  "data-root": "/data/docker",
  "runtimes": {
    "nvidia": { "path": "nvidia-container-runtime", "runtimeArgs": [] },
    "patai-delegate": { "path": "/usr/local/sbin/patai-runc" }
  },
  "default-runtime": "nvidia",
  "log-driver": "local",
  "log-opts": { "max-size": "20m", "max-file": "3" }
}
