#!/usr/bin/env bash
# Workloads publish on loopback only, and the console's gateway is the way in. Docker's rules can
# still route a packet for 127.0.0.1 that arrives from the network, so drop those before it sees them.
# The same rule Docker 28 added; this image has 26 (docs/console.md, What v1 does).
set -euo pipefail
iptables -t raw -C PREROUTING ! -i lo -d 127.0.0.0/8 -j DROP 2>/dev/null \
  || iptables -t raw -I PREROUTING ! -i lo -d 127.0.0.0/8 -j DROP
ip6tables -t raw -C PREROUTING ! -i lo -d ::1 -j DROP 2>/dev/null \
  || ip6tables -t raw -I PREROUTING ! -i lo -d ::1 -j DROP
