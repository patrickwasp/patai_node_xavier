#!/usr/bin/env bash
# Give this boot the unit's identity, whichever slot it is on. A slot holds only what the image
# holds, so what makes a unit itself lives on /persist and is put back here on every boot; the first
# boot of a unit makes it (docs/updates.md, Unit identity).
set -euo pipefail

keep=/persist/identity
provision=/persist/provision
# A broken /persist must not take sshd with it: then the unit runs on what this boot makes.
if mountpoint -q /persist; then
  install -d -m 755 /persist/rauc
else
  keep=/run/patai-identity
fi
install -d -m 700 "$keep"

if [[ -s $keep/machine-id ]]; then
  cmp -s "$keep/machine-id" /etc/machine-id || cp "$keep/machine-id" /etc/machine-id
else
  cp /etc/machine-id "$keep/machine-id"
fi

if compgen -G "$keep/ssh_host_*_key" >/dev/null; then
  cp -p "$keep"/ssh_host_* /etc/ssh/
else
  ssh-keygen -A
  cp -p /etc/ssh/ssh_host_* "$keep/"
fi

name=patai-$(tr -d '\0' < /proc/device-tree/serial-number)
if [[ -s $provision/hostname ]]; then name=$(< "$provision/hostname"); fi
echo "$name" > /etc/hostname
hostname "$name"
sed -i '/^127\.0\.1\.1\b/d' /etc/hosts
echo "127.0.1.1 $name" >> /etc/hosts

if [[ -s $provision/admin-password-hash ]]; then
  usermod -p "$(< "$provision/admin-password-hash")" admin
fi
