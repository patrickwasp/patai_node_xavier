#!/usr/bin/env bash
# Boot settings the stock image gets wrong for a fleet (docs/updates.md).
#
# A kernel panic or hang has to reset the unit, so it counts as a failed boot and rolls back, but
# kernel.panic is 0 and CTI's device tree leaves the watchdog disabled.
#
# The Security Engine has to go: its SHA-256 outranks the CPU's sha256-ce, dm-verity picks it for
# RAUC's verity bundles, and it crashes the kernel with a NULL dereference in
# tegra_se_sha_complete_callback during an install. It's built in, so only the device tree can stop it.
#
# The fan profiles start at PWM 77, which doesn't turn our fan, so a unit gets no airflow until 63 C.
# PWM 120 is the lowest drive it's been seen to start at (docs/hardware.md). /etc/nvfancontrol.conf is
# only a link to this file.
#
#   patai-boot-config [rootfs-dir]     default /; give a mounted slot or an image tree
set -euo pipefail
root=${1:-}
conf=$root/boot/extlinux/extlinux.conf
dtb=$root$(awk '$1 == "FDT" {print $2; exit}' "$conf")
grep -q ' panic=' "$conf" || sed -i '/^ *APPEND / s/$/ panic=10/' "$conf"
fdtput -t s "$dtb" /watchdog@30c0000 status okay
for se in 15810000 15820000 15830000 15840000; do
  fdtput -t s "$dtb" "/host1x@13e00000/se@$se" status disabled
done
fan=$root/etc/nvpower/nvfancontrol/nvfancontrol_p2888.conf
sed -i -E 's/([[:space:]])77([[:space:]]+)1300$/\1120\21990/' "$fan"
if grep -qE '[[:space:]]77[[:space:]]+1300$' "$fan"; then
  echo "fan profile not changed: $fan" >&2
  exit 1
fi
