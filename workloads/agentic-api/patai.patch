+//! patai: the code interpreter's containers, as `OpenAI`'s Responses has them. A container is a folder of files the
+//! guest sees as `/mnt/data` and the Python state its last call left, kept on disk below the gateway's home until
+//! it has been idle for its expiry. Each call still runs in a fresh worker; the container is what carries over.
+//!
+//! ```text
+//! <root>/<cntr_id>/meta.json   what the container is and which files it has, with their ids
+//! <root>/<cntr_id>/files/      the files, at the paths the guest gave them
+//! <root>/<cntr_id>/state.bin   the guest's pickled globals, opaque here, restored by the next call
+//! ```
+//!
+//! Only the gateway writes `files/` while no call runs, and only one call runs in a container at a time.
+
+use std::collections::HashMap;
+use std::fs;
+use std::io::{self, Read, Write};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use serde::{Deserialize, Serialize};
+
+/// Where a container's files appear to the guest.
+pub(crate) const MOUNT: &str = "/mnt/data";
+
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct ContainerLimits {
+    pub(crate) max_containers: usize,
+    pub(crate) max_bytes: u64,
+    pub(crate) max_files: usize,
+    pub(crate) default_idle_minutes: u32,
+}
+
+#[derive(Debug, thiserror::Error)]
+pub(crate) enum ContainerError {
+    #[error("No container found with id '{0}'.")]
+    NotFound(String),
+    #[error("No file found with id '{0}' in this container.")]
+    FileNotFound(String),
+    #[error("{0}")]
+    Invalid(String),
+    #[error("The container is running code. Try again when the call ends.")]
+    Busy,
+    #[error("{0}")]
+    Full(String),
+    #[error("container storage failed")]
+    Io(#[from] io::Error),
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum FileSource {
+    User,
+    Assistant,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub(crate) struct FileMeta {
+    pub(crate) id: String,
+    /// Below the mount, without a leading slash.
+    pub(crate) path: String,
+    pub(crate) bytes: u64,
+    pub(crate) created_at: i64,
+    pub(crate) source: FileSource,
+    /// When the gateway last saw it change, in nanoseconds, to tell what a call changed.
+    modified_ns: u128,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub(crate) struct ContainerMeta {
+    pub(crate) id: String,
+    pub(crate) name: String,
+    pub(crate) created_at: i64,
+    pub(crate) last_active_at: i64,
+    pub(crate) idle_minutes: u32,
+    pub(crate) files: Vec<FileMeta>,
+    /// Who made it, as the gateway names a request's caller (`X-Patai-Caller`): only they can use it. Empty for a
+    /// request that came without one, which reaches only containers made the same way.
+    #[serde(default)]
+    pub(crate) owner: String,
+}
+
+impl ContainerMeta {
+    /// `OpenAI`'s container object.
+    pub(crate) fn object(&self) -> serde_json::Value {
+        serde_json::json!({
+            "id": self.id,
+            "object": "container",
+            "created_at": self.created_at,
+            "status": "running",
+            "expires_after": {"anchor": "last_active_at", "minutes": self.idle_minutes},
+            "last_active_at": self.last_active_at,
+            "name": self.name,
+        })
+    }
+
+    fn expired(&self, now: i64) -> bool {
+        now.saturating_sub(self.last_active_at) > i64::from(self.idle_minutes) * 60
+    }
+}
+
+impl FileMeta {
+    /// `OpenAI`'s container file object.
+    pub(crate) fn object(&self, container_id: &str) -> serde_json::Value {
+        serde_json::json!({
+            "id": self.id,
+            "object": "container.file",
+            "container_id": container_id,
+            "created_at": self.created_at,
+            "bytes": self.bytes,
+            "path": format!("{MOUNT}/{}", self.path),
+            "source": self.source,
+        })
+    }
+}
+
+struct Entry {
+    meta: ContainerMeta,
+    busy: bool,
+}
+
+pub(crate) struct ContainerStore {
+    root: PathBuf,
+    limits: ContainerLimits,
+    entries: Mutex<HashMap<String, Entry>>,
+}
+
+impl std::fmt::Debug for ContainerStore {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ContainerStore")
+            .field("root", &self.root)
+            .finish_non_exhaustive()
+    }
+}
+
+fn now() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |elapsed| i64::try_from(elapsed.as_secs()).unwrap_or(i64::MAX))
+}
+
+fn modified_ns(meta: &fs::Metadata) -> u128 {
+    meta.modified()
+        .ok()
+        .and_then(|time| time.duration_since(UNIX_EPOCH).ok())
+        .map_or(0, |elapsed| elapsed.as_nanos())
+}
+
+fn new_id(prefix: &str) -> String {
+    format!("{prefix}_{}", uuid::Uuid::now_v7().simple())
+}
+
+/// An id the gateway could have made, so a client's id never names a path of its own.
+fn valid_id(prefix: &str, id: &str) -> bool {
+    id.strip_prefix(prefix)
+        .and_then(|rest| rest.strip_prefix('_'))
+        .is_some_and(|hex| {
+            hex.len() == 32
+                && hex
+                    .bytes()
+                    .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+        })
+}
+
+pub(crate) fn valid_container_id(id: &str) -> bool {
+    valid_id("cntr", id)
+}
+
+/// A path below the mount, from a client or a file name: `/mnt/data/x/y.csv`, `/x/y.csv` and `x/y.csv` are the same.
+pub(crate) fn container_path(path: &str) -> Result<String, ContainerError> {
+    let trimmed = path.strip_prefix(MOUNT).unwrap_or(path).trim_start_matches('/');
+    let checked = format!("{MOUNT}/{trimmed}");
+    match relative(&checked) {
+        Some(relative) if !relative.is_empty() => Ok(relative.to_owned()),
+        _ => Err(ContainerError::Invalid(format!(
+            "'{path}' isn't a path a container can hold"
+        ))),
+    }
+}
+
+/// The same checks the guest's storage makes, without Eryx.
+fn relative(path: &str) -> Option<&str> {
+    let rest = path.strip_prefix(MOUNT)?.strip_prefix('/')?;
+    let rest = rest.trim_end_matches('/');
+    if rest.len() > 1024 || rest.split('/').count() > 16 {
+        return None;
+    }
+    rest.split('/')
+        .all(|part| !part.is_empty() && part != "." && part != ".." && !part.contains('\0') && part.len() <= 255)
+        .then_some(rest)
+}
+
+impl ContainerStore {
+    /// Opens the store, keeping the containers on disk that haven't expired and removing the rest.
+    pub(crate) fn open(root: PathBuf, limits: ContainerLimits) -> io::Result<Self> {
+        fs::create_dir_all(&root)?;
+        let mut entries = HashMap::new();
+        let now = now();
+        for entry in fs::read_dir(&root)? {
+            let entry = entry?;
+            let Some(id) = entry.file_name().to_str().map(str::to_owned) else {
+                continue;
+            };
+            let dir = entry.path();
+            let meta = valid_container_id(&id)
+                .then(|| fs::read(dir.join("meta.json")).ok())
+                .flatten()
+                .and_then(|bytes| serde_json::from_slice::<ContainerMeta>(&bytes).ok())
+                .filter(|meta| meta.id == id && !meta.expired(now));
+            match meta {
+                Some(meta) => {
+                    entries.insert(id, Entry { meta, busy: false });
+                }
+                None => remove_tree(&dir),
+            }
+        }
+        Ok(Self {
+            root,
+            limits,
+            entries: Mutex::new(entries),
+        })
+    }
+
+    pub(crate) fn limits(&self) -> ContainerLimits {
+        self.limits
+    }
+
+    fn lock(&self) -> std::sync::MutexGuard<'_, HashMap<String, Entry>> {
+        self.entries.lock().unwrap_or_else(std::sync::PoisonError::into_inner)
+    }
+
+    fn dir(&self, id: &str) -> PathBuf {
+        self.root.join(id)
+    }
+
+    /// Drop expired containers that aren't running.
+    fn sweep(&self, entries: &mut HashMap<String, Entry>) {
+        let now = now();
+        let expired: Vec<String> = entries
+            .iter()
+            .filter(|(_, entry)| !entry.busy && entry.meta.expired(now))
+            .map(|(id, _)| id.clone())
+            .collect();
+        for id in expired {
+            entries.remove(&id);
+            remove_tree(&self.dir(&id));
+        }
+    }
+
+    pub(crate) fn create(
+        &self,
+        name: Option<String>,
+        idle_minutes: Option<u32>,
+        owner: &str,
+    ) -> Result<ContainerMeta, ContainerError> {
+        let idle_minutes = idle_minutes.unwrap_or(self.limits.default_idle_minutes);
+        if !(1..=1440).contains(&idle_minutes) {
+            return Err(ContainerError::Invalid(
+                "expires_after.minutes must be from 1 to 1440".to_owned(),
+            ));
+        }
+        let name = name.unwrap_or_default();
+        if name.len() > 256 {
+            return Err(ContainerError::Invalid(
+                "A container's name can be 256 bytes at most".to_owned(),
+            ));
+        }
+        let mut entries = self.lock();
+        self.sweep(&mut entries);
+        if entries.len() >= self.limits.max_containers {
+            return Err(ContainerError::Full(format!(
+                "This unit keeps {} containers at most. Delete one or wait for one to expire.",
+                self.limits.max_containers
+            )));
+        }
+        let id = new_id("cntr");
+        let created = now();
+        let meta = ContainerMeta {
+            id: id.clone(),
+            name,
+            created_at: created,
+            last_active_at: created,
+            idle_minutes,
+            files: Vec::new(),
+            owner: owner.to_owned(),
+        };
+        fs::create_dir_all(self.dir(&id).join("files"))?;
+        self.write_meta(&meta)?;
+        entries.insert(
+            id,
+            Entry {
+                meta: meta.clone(),
+                busy: false,
+            },
+        );
+        Ok(meta)
+    }
+
+    pub(crate) fn get(&self, id: &str) -> Result<ContainerMeta, ContainerError> {
+        let mut entries = self.lock();
+        self.sweep(&mut entries);
+        entries
+            .get(id)
+            .map(|entry| entry.meta.clone())
+            .ok_or_else(|| ContainerError::NotFound(id.to_owned()))
+    }
+
+    /// The container, if it's `owner`'s: another's answers as if it weren't there.
+    pub(crate) fn owned(&self, id: &str, owner: &str) -> Result<ContainerMeta, ContainerError> {
+        self.get(id)
+            .ok()
+            .filter(|meta| meta.owner == owner)
+            .ok_or_else(|| ContainerError::NotFound(id.to_owned()))
+    }
+
+    /// `owner`'s, newest first unless `ascending`, after the container `after`, and whether there are more.
+    pub(crate) fn list(
+        &self,
+        limit: usize,
+        after: Option<&str>,
+        ascending: bool,
+        owner: &str,
+    ) -> (Vec<ContainerMeta>, bool) {
+        let mut entries = self.lock();
+        self.sweep(&mut entries);
+        let mut all: Vec<ContainerMeta> = entries
+            .values()
+            .filter(|entry| entry.meta.owner == owner)
+            .map(|entry| entry.meta.clone())
+            .collect();
+        all.sort_by(|a, b| (a.created_at, &a.id).cmp(&(b.created_at, &b.id)));
+        if !ascending {
+            all.reverse();
+        }
+        page(all, |meta| meta.id.as_str(), limit, after)
+    }
+
+    pub(crate) fn delete(&self, id: &str) -> Result<(), ContainerError> {
+        let mut entries = self.lock();
+        match entries.get(id) {
+            None => Err(ContainerError::NotFound(id.to_owned())),
+            Some(entry) if entry.busy => Err(ContainerError::Busy),
+            Some(_) => {
+                entries.remove(id);
+                remove_tree(&self.dir(id));
+                Ok(())
+            }
+        }
+    }
+
+    /// The file and where it is on disk.
+    pub(crate) fn file(&self, id: &str, file_id: &str) -> Result<(FileMeta, PathBuf), ContainerError> {
+        let meta = self.get(id)?;
+        let file = meta
+            .files
+            .into_iter()
+            .find(|file| file.id == file_id)
+            .ok_or_else(|| ContainerError::FileNotFound(file_id.to_owned()))?;
+        let path = self.dir(id).join("files").join(&file.path);
+        Ok((file, path))
+    }
+
+    pub(crate) fn delete_file(self: &Arc<Self>, id: &str, file_id: &str) -> Result<(), ContainerError> {
+        let lease = self.lease(id)?;
+        let mut meta = lease.meta.clone();
+        let index = meta
+            .files
+            .iter()
+            .position(|file| file.id == file_id)
+            .ok_or_else(|| ContainerError::FileNotFound(file_id.to_owned()))?;
+        let file = meta.files.remove(index);
+        match fs::remove_file(lease.files_dir.join(&file.path)) {
+            Ok(()) => {}
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error.into()),
+        }
+        lease.finish_with(meta, false)
+    }
+
+    /// Put a user's file in the container at `path` (below the mount), replacing one there, within its caps.
+    pub(crate) fn add_file(
+        self: &Arc<Self>,
+        id: &str,
+        path: &str,
+        mut content: impl Read,
+    ) -> Result<FileMeta, ContainerError> {
+        let relative = container_path(path)?;
+        let lease = self.lease(id)?;
+        let mut meta = lease.meta.clone();
+        let replaced = meta.files.iter().position(|file| file.path == relative);
+        let used: u64 = meta
+            .files
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| Some(*index) != replaced)
+            .map(|(_, file)| file.bytes)
+            .sum();
+        if replaced.is_none() && meta.files.len() >= self.limits.max_files {
+            return Err(ContainerError::Full(format!(
+                "A container holds {} files at most.",
+                self.limits.max_files
+            )));
+        }
+        let room = self.limits.max_bytes.saturating_sub(used);
+        let target = lease.files_dir.join(&relative);
+        if let Some(parent) = target.parent() {
+            fs::create_dir_all(parent)?;
+        }
+        let staging = lease.dir.join(format!(".upload-{}", uuid::Uuid::now_v7().simple()));
+        let copied = copy_bounded(&mut content, &staging, room);
+        let bytes = match copied {
+            Ok(Some(bytes)) => bytes,
+            Ok(None) => {
+                let _ = fs::remove_file(&staging);
+                return Err(ContainerError::Full(format!(
+                    "A container holds {} bytes at most.",
+                    self.limits.max_bytes
+                )));
+            }
+            Err(error) => {
+                let _ = fs::remove_file(&staging);
+                return Err(error.into());
+            }
+        };
+        if fs::symlink_metadata(&target).is_ok_and(|existing| existing.is_dir()) {
+            let _ = fs::remove_file(&staging);
+            return Err(ContainerError::Invalid(format!(
+                "'{path}' is a folder in this container"
+            )));
+        }
+        fs::rename(&staging, &target)?;
+        let file = FileMeta {
+            id: new_id("cfile"),
+            path: relative,
+            bytes,
+            created_at: now(),
+            source: FileSource::User,
+            modified_ns: fs::symlink_metadata(&target).map_or(0, |meta| modified_ns(&meta)),
+        };
+        match replaced {
+            Some(index) => meta.files[index] = file.clone(),
+            None => meta.files.push(file.clone()),
+        }
+        lease.finish_with(meta, true)?;
+        Ok(file)
+    }
+
+    /// Hold the container for one call or file change: no other starts until it ends.
+    pub(crate) fn lease(self: &Arc<Self>, id: &str) -> Result<Lease, ContainerError> {
+        let mut entries = self.lock();
+        self.sweep(&mut entries);
+        let entry = entries
+            .get_mut(id)
+            .ok_or_else(|| ContainerError::NotFound(id.to_owned()))?;
+        if entry.busy {
+            return Err(ContainerError::Busy);
+        }
+        entry.busy = true;
+        let dir = self.dir(id);
+        Ok(Lease {
+            store: Arc::clone(self),
+            meta: entry.meta.clone(),
+            files_dir: dir.join("files"),
+            state_path: dir.join("state.bin"),
+            dir,
+            released: false,
+        })
+    }
+
+    fn release(&self, id: &str, meta: Option<ContainerMeta>, touch: bool) -> Result<(), ContainerError> {
+        let mut entries = self.lock();
+        let Some(entry) = entries.get_mut(id) else {
+            return Ok(());
+        };
+        entry.busy = false;
+        if let Some(mut meta) = meta {
+            if touch {
+                meta.last_active_at = now();
+            }
+            self.write_meta(&meta)?;
+            entry.meta = meta;
+        }
+        Ok(())
+    }
+
+    fn write_meta(&self, meta: &ContainerMeta) -> io::Result<()> {
+        let dir = self.dir(&meta.id);
+        let staging = dir.join("meta.json.new");
+        fs::write(&staging, serde_json::to_vec(meta).map_err(io::Error::other)?)?;
+        fs::rename(staging, dir.join("meta.json"))
+    }
+}
+
+/// One call's or one change's hold on a container. Dropping it without finishing releases the container as the
+/// call left it on disk.
+pub(crate) struct Lease {
+    store: Arc<ContainerStore>,
+    pub(crate) meta: ContainerMeta,
+    pub(crate) dir: PathBuf,
+    pub(crate) files_dir: PathBuf,
+    pub(crate) state_path: PathBuf,
+    released: bool,
+}
+
+impl std::fmt::Debug for Lease {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Lease")
+            .field("container", &self.meta.id)
+            .finish_non_exhaustive()
+    }
+}
+
+impl Lease {
+    fn finish_with(mut self, meta: ContainerMeta, touch: bool) -> Result<(), ContainerError> {
+        self.released = true;
+        self.store.release(&self.meta.id, Some(meta), touch)
+    }
+
+    /// After a call: what's in `files/` now, with ids kept for files at the same path and new ones for the rest.
+    /// Returns the files this call made or changed.
+    pub(crate) fn finish(self) -> Result<Vec<FileMeta>, ContainerError> {
+        let mut meta = self.meta.clone();
+        let changed = rescan(&self.files_dir, &mut meta)?;
+        self.finish_with(meta, true)?;
+        Ok(changed)
+    }
+}
+
+impl Drop for Lease {
+    fn drop(&mut self) {
+        if self.released {
+            return;
+        }
+        let mut meta = self.meta.clone();
+        let rescanned = rescan(&self.files_dir, &mut meta).ok().map(|_| meta);
+        if let Err(error) = self.store.release(&self.meta.id, rescanned, true) {
+            tracing::warn!(%error, container = %self.meta.id, "couldn't record a code interpreter container");
+        }
+    }
+}
+
+/// Copy at most `room` bytes into a new file; `None` if there was more.
+fn copy_bounded(content: &mut impl Read, target: &Path, room: u64) -> io::Result<Option<u64>> {
+    let mut file = fs::OpenOptions::new().write(true).create_new(true).open(target)?;
+    let mut limited = content.take(room.saturating_add(1));
+    let copied = io::copy(&mut limited, &mut file)?;
+    if copied > room {
+        return Ok(None);
+    }
+    file.flush()?;
+    Ok(Some(copied))
+}
+
+/// Bring `meta.files` in line with the folder: regular files only, at depth and name limits the guest's storage
+/// keeps. Returns what's new or changed.
+fn rescan(files_dir: &Path, meta: &mut ContainerMeta) -> Result<Vec<FileMeta>, ContainerError> {
+    let mut found: Vec<(String, u64, u128)> = Vec::new();
+    let mut pending = vec![(files_dir.to_path_buf(), String::new())];
+    while let Some((dir, prefix)) = pending.pop() {
+        let listing = match fs::read_dir(&dir) {
+            Ok(listing) => listing,
+            Err(error) if error.kind() == io::ErrorKind::NotFound && prefix.is_empty() => {
+                fs::create_dir_all(files_dir)?;
+                continue;
+            }
+            Err(error) => return Err(error.into()),
+        };
+        for entry in listing {
+            let entry = entry?;
+            let Some(name) = entry.file_name().to_str().map(str::to_owned) else {
+                continue;
+            };
+            let path = if prefix.is_empty() {
+                name
+            } else {
+                format!("{prefix}/{name}")
+            };
+            let kind = entry.file_type()?;
+            if kind.is_dir() {
+                pending.push((entry.path(), path));
+            } else if kind.is_file() {
+                let file_meta = entry.metadata()?;
+                found.push((path, file_meta.len(), modified_ns(&file_meta)));
+            }
+        }
+    }
+    let mut previous: HashMap<String, FileMeta> = meta.files.drain(..).map(|file| (file.path.clone(), file)).collect();
+    let mut changed = Vec::new();
+    let created = now();
+    found.sort();
+    for (path, bytes, modified) in found {
+        let file = if let Some(mut file) = previous.remove(&path) {
+            if file.bytes != bytes || file.modified_ns != modified {
+                file.bytes = bytes;
+                file.modified_ns = modified;
+                file.source = FileSource::Assistant;
+                changed.push(file.clone());
+            }
+            file
+        } else {
+            let file = FileMeta {
+                id: new_id("cfile"),
+                path,
+                bytes,
+                created_at: created,
+                source: FileSource::Assistant,
+                modified_ns: modified,
+            };
+            changed.push(file.clone());
+            file
+        };
+        meta.files.push(file);
+    }
+    Ok(changed)
+}
+
+fn remove_tree(dir: &Path) {
+    if let Err(error) = fs::remove_dir_all(dir)
+        && error.kind() != io::ErrorKind::NotFound
+    {
+        tracing::warn!(%error, dir = %dir.display(), "couldn't remove an expired code interpreter container");
+    }
+}
+
+/// A page of `items` after the one with id `after`, and whether more follow.
+pub(crate) fn page<T>(items: Vec<T>, id: impl Fn(&T) -> &str, limit: usize, after: Option<&str>) -> (Vec<T>, bool) {
+    let start = after
+        .and_then(|after| items.iter().position(|item| id(item) == after).map(|index| index + 1))
+        .unwrap_or(0);
+    let mut rest: Vec<T> = items.into_iter().skip(start).collect();
+    let more = rest.len() > limit;
+    rest.truncate(limit);
+    (rest, more)
+}
+
+impl ContainerLimits {
+    /// patai: from `AGENTIC_CODE_INTERPRETER_CONTAINER_*`, the same way the other limits are set.
+    pub(crate) fn from_env() -> Result<Self, String> {
+        fn read<T: std::str::FromStr>(name: &str, default: T) -> Result<T, String> {
+            match std::env::var(name) {
+                Ok(value) => value
+                    .trim()
+                    .parse()
+                    .map_err(|_| format!("{name} must be a positive number")),
+                Err(_) => Ok(default),
+            }
+        }
+        let limits = Self {
+            max_containers: read("AGENTIC_CODE_INTERPRETER_MAX_CONTAINERS", 16)?,
+            max_bytes: read("AGENTIC_CODE_INTERPRETER_CONTAINER_MAX_BYTES", 512 * 1024 * 1024)?,
+            max_files: read("AGENTIC_CODE_INTERPRETER_CONTAINER_MAX_FILES", 1000)?,
+            default_idle_minutes: read("AGENTIC_CODE_INTERPRETER_CONTAINER_IDLE_MINUTES", 20)?,
+        };
+        if limits.max_containers == 0
+            || limits.max_bytes == 0
+            || limits.max_files == 0
+            || limits.default_idle_minutes == 0
+        {
+            return Err("code interpreter container limits must be positive".to_owned());
+        }
+        Ok(limits)
+    }
+}
