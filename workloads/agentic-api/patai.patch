new file mode 100644
index 0000000..9d5b6c9
--- /dev/null
+++ b/crates/agentic-server-core/src/tool/code_interpreter/disk.rs
@@ -0,0 +1,504 @@
+//! patai: a container's files as the guest sees them at `/mnt/data`, kept in a host folder that only this worker
+//! touches while it runs, with a cap on their total size and on how many there are.
+//!
+//! Eryx's host volumes cap each file but not the total, and its in-memory storage holds everything in the worker's
+//! memory. This is the in-memory storage's contract on disk: paths are the guest's, absolute, below the mount; a
+//! write past the cap fails as `ENOSPC`; nothing here follows a symbolic link, and nothing makes one.
+
+use std::fs::{self, File, OpenOptions};
+use std::io::{Read, Seek, SeekFrom, Write};
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+use std::time::SystemTime;
+
+use async_trait::async_trait;
+use eryx::vfs::{DirEntry, Metadata, VfsError, VfsResult, VfsStorage};
+
+/// The longest name and path the guest may use, and how deep its folders go.
+const MAX_NAME_BYTES: usize = 255;
+const MAX_PATH_BYTES: usize = 1024;
+const MAX_DEPTH: usize = 16;
+
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub(super) struct Usage {
+    pub(super) bytes: u64,
+    pub(super) entries: usize,
+}
+
+pub(super) struct DiskStorage {
+    mount: String,
+    root: PathBuf,
+    max_bytes: u64,
+    max_entries: usize,
+    used: Mutex<Usage>,
+}
+
+impl DiskStorage {
+    /// The folder must exist. What's in it already counts against the caps.
+    pub(super) fn new(mount: &str, root: &Path, max_bytes: u64, max_entries: usize) -> std::io::Result<Self> {
+        let used = usage(root)?;
+        Ok(Self {
+            mount: mount.trim_end_matches('/').to_owned(),
+            root: root.to_path_buf(),
+            max_bytes,
+            max_entries,
+            used: Mutex::new(used),
+        })
+    }
+
+    fn used(&self) -> std::sync::MutexGuard<'_, Usage> {
+        self.used.lock().unwrap_or_else(std::sync::PoisonError::into_inner)
+    }
+
+    /// The host path for a guest path below the mount.
+    fn host(&self, path: &str) -> VfsResult<PathBuf> {
+        let relative = relative(&self.mount, path)?;
+        Ok(if relative.is_empty() {
+            self.root.clone()
+        } else {
+            self.root.join(relative)
+        })
+    }
+
+    /// Reserve `bytes` more, and an entry if `new_entry`.
+    fn reserve(&self, bytes: u64, new_entry: bool) -> VfsResult<()> {
+        let mut used = self.used();
+        let total = used.bytes.saturating_add(bytes);
+        if total > self.max_bytes {
+            return Err(VfsError::QuotaExceeded(format!(
+                "/mnt/data would hold {total} bytes, over its {} byte limit",
+                self.max_bytes
+            )));
+        }
+        if new_entry && used.entries >= self.max_entries {
+            return Err(VfsError::QuotaExceeded(format!(
+                "/mnt/data holds its limit of {} files and folders",
+                self.max_entries
+            )));
+        }
+        used.bytes = total;
+        if new_entry {
+            used.entries += 1;
+        }
+        Ok(())
+    }
+
+    fn release(&self, bytes: u64, entries: usize) {
+        let mut used = self.used();
+        used.bytes = used.bytes.saturating_sub(bytes);
+        used.entries = used.entries.saturating_sub(entries);
+    }
+
+    /// Change a file's size from `old` to `new` in the account, before the change.
+    fn resize(&self, old: Option<u64>, new: u64) -> VfsResult<()> {
+        let current = old.unwrap_or(0);
+        if new > current {
+            self.reserve(new - current, old.is_none())
+        } else {
+            if old.is_none() {
+                self.reserve(0, true)?;
+            }
+            self.release(current - new, 0);
+            Ok(())
+        }
+    }
+}
+
+/// The part of `path` below `mount`, checked: no `.`, `..` or empty parts, and bounded names and depth.
+pub(super) fn relative<'a>(mount: &str, path: &'a str) -> VfsResult<&'a str> {
+    let rest = if path == mount {
+        ""
+    } else {
+        path.strip_prefix(mount)
+            .and_then(|rest| rest.strip_prefix('/'))
+            .ok_or_else(|| VfsError::InvalidPath(format!("{path} is outside {mount}")))?
+    };
+    let rest = rest.trim_end_matches('/');
+    if rest.len() > MAX_PATH_BYTES {
+        return Err(VfsError::NameTooLong(path.to_owned()));
+    }
+    if rest.is_empty() {
+        return Ok(rest);
+    }
+    let mut depth = 0;
+    for part in rest.split('/') {
+        depth += 1;
+        if part.is_empty() || part == "." || part == ".." || part.contains('\0') {
+            return Err(VfsError::InvalidPath(path.to_owned()));
+        }
+        if part.len() > MAX_NAME_BYTES {
+            return Err(VfsError::NameTooLong(path.to_owned()));
+        }
+    }
+    if depth > MAX_DEPTH {
+        return Err(VfsError::InvalidPath(format!(
+            "{path} is more than {MAX_DEPTH} folders deep"
+        )));
+    }
+    Ok(rest)
+}
+
+/// What a folder holds: every regular file's bytes, and every file and folder below it. Symbolic links and
+/// anything else are refused.
+pub(super) fn usage(root: &Path) -> std::io::Result<Usage> {
+    let mut usage = Usage::default();
+    let mut pending = vec![root.to_path_buf()];
+    while let Some(dir) = pending.pop() {
+        for entry in fs::read_dir(&dir)? {
+            let entry = entry?;
+            let kind = entry.file_type()?;
+            if kind.is_dir() {
+                pending.push(entry.path());
+            } else if kind.is_file() {
+                usage.bytes = usage.bytes.saturating_add(entry.metadata()?.len());
+            } else {
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::InvalidData,
+                    "a container holds something other than files and folders",
+                ));
+            }
+            usage.entries += 1;
+        }
+    }
+    Ok(usage)
+}
+
+fn io(error: &std::io::Error, path: &str) -> VfsError {
+    use std::io::ErrorKind;
+    match error.kind() {
+        ErrorKind::NotFound => VfsError::NotFound(path.to_owned()),
+        ErrorKind::AlreadyExists => VfsError::AlreadyExists(path.to_owned()),
+        ErrorKind::PermissionDenied => VfsError::PermissionDenied(path.to_owned()),
+        ErrorKind::NotADirectory => VfsError::NotDirectory(path.to_owned()),
+        ErrorKind::IsADirectory => VfsError::NotFile(path.to_owned()),
+        ErrorKind::DirectoryNotEmpty => VfsError::DirectoryNotEmpty(path.to_owned()),
+        ErrorKind::InvalidFilename => VfsError::NameTooLong(path.to_owned()),
+        // A symbolic link that O_NOFOLLOW refused: there are none, unless someone else made one.
+        _ if error.raw_os_error() == Some(libc::ELOOP) => VfsError::PermissionDenied(path.to_owned()),
+        _ => VfsError::Io(format!("{path}: {}", error.kind())),
+    }
+}
+
+/// Open without following a link at the last part; no part before it can be one, as nothing makes links.
+fn open(path: &Path, options: &mut OpenOptions) -> std::io::Result<File> {
+    options.custom_flags(libc::O_NOFOLLOW).open(path)
+}
+
+/// The size of a regular file there, `None` if there's nothing, and an error for anything else.
+fn file_size(host: &Path, path: &str) -> VfsResult<Option<u64>> {
+    match fs::symlink_metadata(host) {
+        Ok(meta) if meta.is_file() => Ok(Some(meta.len())),
+        Ok(meta) if meta.is_dir() => Err(VfsError::NotFile(path.to_owned())),
+        Ok(_) => Err(VfsError::PermissionDenied(path.to_owned())),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(io(&error, path)),
+    }
+}
+
+fn metadata(meta: &fs::Metadata) -> Metadata {
+    let now = SystemTime::now();
+    Metadata {
+        is_dir: meta.is_dir(),
+        size: if meta.is_dir() { 0 } else { meta.len() },
+        created: meta.created().unwrap_or(now),
+        modified: meta.modified().unwrap_or(now),
+        accessed: meta.accessed().unwrap_or(now),
+    }
+}
+
+// Every operation is synchronous inside its future, so a dropped poll can't leave half of one done.
+#[async_trait]
+impl VfsStorage for DiskStorage {
+    async fn read(&self, path: &str) -> VfsResult<Vec<u8>> {
+        let host = self.host(path)?;
+        let mut file = open(&host, OpenOptions::new().read(true)).map_err(|error| io(&error, path))?;
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes).map_err(|error| io(&error, path))?;
+        Ok(bytes)
+    }
+
+    async fn read_at(&self, path: &str, offset: u64, len: u64) -> VfsResult<Vec<u8>> {
+        let host = self.host(path)?;
+        let mut file = open(&host, OpenOptions::new().read(true)).map_err(|error| io(&error, path))?;
+        let size = file.metadata().map_err(|error| io(&error, path))?.len();
+        // The guest picks len: never allocate past what the file holds.
+        let len = len.min(size.saturating_sub(offset));
+        let mut bytes = vec![0; usize::try_from(len).map_err(|_| VfsError::InvalidSeek(path.to_owned()))?];
+        file.seek(SeekFrom::Start(offset)).map_err(|error| io(&error, path))?;
+        file.read_exact(&mut bytes).map_err(|error| io(&error, path))?;
+        Ok(bytes)
+    }
+
+    async fn write(&self, path: &str, data: &[u8]) -> VfsResult<()> {
+        let host = self.host(path)?;
+        let old = file_size(&host, path)?;
+        self.resize(old, data.len() as u64)?;
+        let written = open(&host, OpenOptions::new().write(true).create(true).truncate(true))
+            .and_then(|mut file| file.write_all(data));
+        if let Err(error) = written {
+            // Count what's there now, whatever the write left.
+            self.resync(&host, old.is_none(), data.len() as u64);
+            return Err(io(&error, path));
+        }
+        Ok(())
+    }
+
+    // Opening with create makes the file (with `write`), so a file that isn't there was deleted while open: a write
+    // to it fails rather than bring it back.
+    async fn write_at(&self, path: &str, offset: u64, data: &[u8]) -> VfsResult<()> {
+        let host = self.host(path)?;
+        let old = file_size(&host, path)?.ok_or_else(|| VfsError::NotFound(path.to_owned()))?;
+        let end = offset
+            .checked_add(data.len() as u64)
+            .ok_or_else(|| VfsError::InvalidSeek(path.to_owned()))?;
+        let new = end.max(old);
+        self.resize(Some(old), new)?;
+        let written = open(&host, OpenOptions::new().write(true)).and_then(|mut file| {
+            file.seek(SeekFrom::Start(offset))?;
+            file.write_all(data)
+        });
+        if let Err(error) = written {
+            self.resync(&host, false, new);
+            return Err(io(&error, path));
+        }
+        Ok(())
+    }
+
+    async fn set_size(&self, path: &str, size: u64) -> VfsResult<()> {
+        let host = self.host(path)?;
+        let old = file_size(&host, path)?.ok_or_else(|| VfsError::NotFound(path.to_owned()))?;
+        self.resize(Some(old), size)?;
+        open(&host, OpenOptions::new().write(true))
+            .and_then(|file| file.set_len(size))
+            .map_err(|error| {
+                self.resync(&host, false, size);
+                io(&error, path)
+            })
+    }
+
+    async fn delete(&self, path: &str) -> VfsResult<()> {
+        let host = self.host(path)?;
+        let size = file_size(&host, path)?.ok_or_else(|| VfsError::NotFound(path.to_owned()))?;
+        fs::remove_file(&host).map_err(|error| io(&error, path))?;
+        self.release(size, 1);
+        Ok(())
+    }
+
+    async fn exists(&self, path: &str) -> VfsResult<bool> {
+        let host = self.host(path)?;
+        Ok(fs::symlink_metadata(host).is_ok())
+    }
+
+    async fn list(&self, path: &str) -> VfsResult<Vec<DirEntry>> {
+        let host = self.host(path)?;
+        let mut entries = Vec::new();
+        for entry in fs::read_dir(&host).map_err(|error| io(&error, path))? {
+            let entry = entry.map_err(|error| io(&error, path))?;
+            let meta = entry.metadata().map_err(|error| io(&error, path))?;
+            if !meta.is_file() && !meta.is_dir() {
+                continue;
+            }
+            let Ok(name) = entry.file_name().into_string() else {
+                continue;
+            };
+            entries.push(DirEntry {
+                name,
+                metadata: metadata(&meta),
+            });
+        }
+        Ok(entries)
+    }
+
+    async fn stat(&self, path: &str) -> VfsResult<Metadata> {
+        let host = self.host(path)?;
+        let meta = fs::symlink_metadata(&host).map_err(|error| io(&error, path))?;
+        if !meta.is_file() && !meta.is_dir() {
+            return Err(VfsError::PermissionDenied(path.to_owned()));
+        }
+        Ok(metadata(&meta))
+    }
+
+    async fn mkdir(&self, path: &str) -> VfsResult<()> {
+        let host = self.host(path)?;
+        self.reserve(0, true)?;
+        fs::create_dir(&host).map_err(|error| {
+            self.release(0, 1);
+            io(&error, path)
+        })
+    }
+
+    async fn rmdir(&self, path: &str) -> VfsResult<()> {
+        let host = self.host(path)?;
+        if host == self.root {
+            return Err(VfsError::PermissionDenied(path.to_owned()));
+        }
+        fs::remove_dir(&host).map_err(|error| io(&error, path))?;
+        self.release(0, 1);
+        Ok(())
+    }
+
+    async fn rename(&self, from: &str, to: &str) -> VfsResult<()> {
+        let source = self.host(from)?;
+        let target = self.host(to)?;
+        if source == self.root || target == self.root {
+            return Err(VfsError::PermissionDenied(from.to_owned()));
+        }
+        fs::symlink_metadata(&source).map_err(|error| io(&error, from))?;
+        // A file the rename replaces goes from the account.
+        let replaced = match fs::symlink_metadata(&target) {
+            Ok(meta) if meta.is_file() => Some(meta.len()),
+            Ok(meta) if meta.is_dir() => Some(0),
+            Ok(_) => return Err(VfsError::PermissionDenied(to.to_owned())),
+            Err(_) => None,
+        };
+        fs::rename(&source, &target).map_err(|error| io(&error, from))?;
+        if let Some(bytes) = replaced {
+            self.release(bytes, 1);
+        }
+        Ok(())
+    }
+
+    async fn set_times(&self, path: &str, accessed: Option<SystemTime>, modified: Option<SystemTime>) -> VfsResult<()> {
+        let host = self.host(path)?;
+        let file = open(&host, OpenOptions::new().read(true)).map_err(|error| io(&error, path))?;
+        let mut times = fs::FileTimes::new();
+        if let Some(accessed) = accessed {
+            times = times.set_accessed(accessed);
+        }
+        if let Some(modified) = modified {
+            times = times.set_modified(modified);
+        }
+        file.set_times(times).map_err(|error| io(&error, path))
+    }
+
+    fn mkdir_sync(&self, path: &str) -> VfsResult<()> {
+        // Only the mount itself, which exists.
+        if self.host(path)? == self.root {
+            Ok(())
+        } else {
+            Err(VfsError::Unsupported(format!("mkdir_sync: {path}")))
+        }
+    }
+}
+
+impl DiskStorage {
+    /// After a failed write, count the file as it is, not as it was meant to be.
+    fn resync(&self, host: &Path, was_new: bool, reserved: u64) {
+        let actual = fs::symlink_metadata(host)
+            .ok()
+            .filter(fs::Metadata::is_file)
+            .map(|meta| meta.len());
+        let mut used = self.used();
+        used.bytes = used.bytes.saturating_sub(reserved).saturating_add(actual.unwrap_or(0));
+        if was_new && actual.is_none() {
+            used.entries = used.entries.saturating_sub(1);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
