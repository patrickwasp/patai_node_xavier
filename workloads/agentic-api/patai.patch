+/// patai: the Containers API's view of the store, for the server's routes, as one caller sees it: their containers and
+/// nobody else's. Answers are `OpenAI`'s objects.
+#[derive(Clone)]
+pub struct Containers {
+    store: Arc<ContainerStore>,
+    files: Option<crate::tool::file_search::FileSearchService>,
+    owner: String,
+    runner: Arc<super::CodeInterpreterExecutor>,
+}
+
+/// What a Containers API call can fail with, and the HTTP status it means.
+#[derive(Debug)]
+pub struct ContainersError {
+    pub status: u16,
+    pub message: String,
+}
+
+impl From<ContainerError> for ContainersError {
+    fn from(error: ContainerError) -> Self {
+        let status = match &error {
+            ContainerError::NotFound(_) | ContainerError::FileNotFound(_) => 404,
+            ContainerError::Invalid(_) => 400,
+            ContainerError::Busy => 409,
+            ContainerError::Full(_) => 413,
+            ContainerError::Io(error) => {
+                tracing::error!(%error, "code interpreter container storage failed");
+                500
+            }
+        };
+        Self {
+            status,
+            message: error.to_string(),
+        }
+    }
+}
+
+fn invalid(message: impl Into<String>) -> ContainersError {
+    ContainersError {
+        status: 400,
+        message: message.into(),
+    }
+}
+
+/// `OpenAI`'s list object.
+fn list_object(data: &[serde_json::Value], more: bool) -> serde_json::Value {
+    let first = data.first().and_then(|item| item["id"].as_str()).map(str::to_owned);
+    let last = data.last().and_then(|item| item["id"].as_str()).map(str::to_owned);
+    serde_json::json!({"object": "list", "data": data, "first_id": first, "last_id": last, "has_more": more})
+}
+
+impl Containers {
+    pub(crate) fn new(
+        store: Arc<ContainerStore>,
+        files: Option<crate::tool::file_search::FileSearchService>,
+        owner: &str,
+        runner: Arc<super::CodeInterpreterExecutor>,
+    ) -> Self {
+        Self {
+            store,
+            files,
+            owner: owner.to_owned(),
+            runner,
+        }
+    }
+
+    fn owned(&self, id: &str) -> Result<ContainerMeta, ContainersError> {
+        Ok(self.store.owned(id, &self.owner)?)
+    }
+
+    /// patai: run `code` in the container, one run after another in it, and answer with what it printed and the files
+    /// it made or changed. A run waits its turn for the interpreter, a `background` one behind the rest.
+    ///
+    /// # Errors
+    ///
+    /// A [`ContainersError`] with the HTTP status to answer: 404 for a container that isn't the caller's, 409 while
+    /// another run is in it, 429 when the interpreter stayed busy.
+    pub async fn run(&self, id: &str, code: String, background: bool) -> Result<serde_json::Value, ContainersError> {
+        self.owned(id)?;
+        self.runner.run_in(id, code, background).await
+    }
+
+    /// The largest upload a container can take.
+    #[must_use]
+    pub fn max_bytes(&self) -> u64 {
+        self.store.limits.max_bytes
+    }
+
+    /// A new container, with each Files API file in `file_ids` copied in.
+    ///
+    /// # Errors
+    ///
+    /// A [`ContainersError`] with the HTTP status to answer.
+    pub async fn create(
+        &self,
+        name: Option<String>,
+        idle_minutes: Option<u32>,
+        file_ids: Vec<String>,
+    ) -> Result<serde_json::Value, ContainersError> {
+        if file_ids.len() > 32 {
+            return Err(invalid("A container takes 32 file_ids at most"));
+        }
+        let meta = self.store.create(name, idle_minutes, &self.owner)?;
+        for file_id in &file_ids {
+            if let Err(error) = self.add_from_files_api(&meta.id, file_id).await {
+                let _ = self.store.delete(&meta.id);
+                return Err(error);
+            }
+        }
+        Ok(self.store.get(&meta.id)?.object())
+    }
+
+    /// The container.
+    ///
+    /// # Errors
+    ///
+    /// A [`ContainersError`] with the HTTP status to answer.
+    pub fn get(&self, id: &str) -> Result<serde_json::Value, ContainersError> {
+        Ok(self.owned(id)?.object())
+    }
+
+    #[must_use]
+    pub fn list(&self, limit: usize, after: Option<&str>, ascending: bool) -> serde_json::Value {
+        let (page, more) = self.store.list(limit.clamp(1, 100), after, ascending, &self.owner);
+        list_object(&page.iter().map(ContainerMeta::object).collect::<Vec<_>>(), more)
+    }
+
+    /// Removes the container, its files and its state.
+    ///
+    /// # Errors
+    ///
+    /// A [`ContainersError`] with the HTTP status to answer.
+    pub fn delete(&self, id: &str) -> Result<serde_json::Value, ContainersError> {
+        self.owned(id)?;
+        self.store.delete(id)?;
+        Ok(serde_json::json!({"id": id, "object": "container.deleted", "deleted": true}))
+    }
+
+    /// A page of the container's files.
+    ///
+    /// # Errors
+    ///
+    /// A [`ContainersError`] with the HTTP status to answer.
+    pub fn list_files(
+        &self,
+        id: &str,
+        limit: usize,
+        after: Option<&str>,
+        ascending: bool,
+    ) -> Result<serde_json::Value, ContainersError> {
+        let mut files = self.owned(id)?.files;
+        files.sort_by(|a, b| (a.created_at, &a.id).cmp(&(b.created_at, &b.id)));
+        if !ascending {
+            files.reverse();
+        }
+        let (page, more) = page(files, |file| file.id.as_str(), limit.clamp(1, 100), after);
+        Ok(list_object(
+            &page.iter().map(|file| file.object(id)).collect::<Vec<_>>(),
+            more,
+        ))
+    }
+
+    /// One of the container's files.
+    ///
+    /// # Errors
+    ///
+    /// A [`ContainersError`] with the HTTP status to answer.
+    pub fn file(&self, id: &str, file_id: &str) -> Result<serde_json::Value, ContainersError> {
+        self.owned(id)?;
+        let (file, _) = self.store.file(id, file_id)?;
+        Ok(file.object(id))
+    }
+
+    /// Where the file is on disk, and its name, to send it.
+    ///
+    /// # Errors
+    ///
+    /// A [`ContainersError`] with the HTTP status to answer.
+    pub fn file_content(&self, id: &str, file_id: &str) -> Result<(PathBuf, String), ContainersError> {
+        self.owned(id)?;
+        let (file, path) = self.store.file(id, file_id)?;
+        let name = file.path.rsplit('/').next().unwrap_or(&file.path).to_owned();
+        Ok((path, name))
+    }
+
+    /// Removes one of the container's files.
+    ///
+    /// # Errors
+    ///
+    /// A [`ContainersError`] with the HTTP status to answer.
+    pub fn delete_file(&self, id: &str, file_id: &str) -> Result<serde_json::Value, ContainersError> {
+        self.owned(id)?;
+        self.store.delete_file(id, file_id)?;
+        Ok(serde_json::json!({"id": file_id, "object": "container.file.deleted", "deleted": true}))
+    }
+
+    /// An upload, read in full, as `path` (a file name or a path below `/mnt/data`). Blocks: call it off the
+    /// runtime's threads.
+    ///
+    /// # Errors
+    ///
+    /// A [`ContainersError`] with the HTTP status to answer.
+    pub fn add_file(&self, id: &str, path: &str, content: impl Read) -> Result<serde_json::Value, ContainersError> {
+        self.owned(id)?;
+        Ok(self.store.add_file(id, path, content)?.object(id))
+    }
+
+    /// A Files API file, under its own name.
+    ///
+    /// # Errors
+    ///
+    /// A [`ContainersError`] with the HTTP status to answer.
+    pub async fn add_from_files_api(&self, id: &str, file_id: &str) -> Result<serde_json::Value, ContainersError> {
+        self.owned(id)?;
+        let files = self.files.as_ref().ok_or_else(|| ContainersError {
+            status: 503,
+            message: "The Files API isn't available".to_owned(),
+        })?;
+        let not_found = |error: crate::tool::file_search::FileSearchError| ContainersError {
+            status: 404,
+            message: error.public_message(),
+        };
+        let found = files.get_file(file_id).await.map_err(not_found)?;
+        let bytes = files.file_content(file_id).await.map_err(not_found)?;
+        let store = Arc::clone(&self.store);
+        let id = id.to_owned();
+        tokio::task::spawn_blocking(move || {
+            store
+                .add_file(&id, &found.filename, &bytes[..])
+                .map(|file| file.object(&id))
+        })
+        .await
+        .map_err(|_| ContainersError {
+            status: 500,
+            message: "container storage failed".to_owned(),
+        })?
+        .map_err(ContainersError::from)
+    }
+}
