+            owner: owner.to_owned(),
+            explicit,
+            history: history_container(history),
+            file_ids,
+            chosen: std::sync::Mutex::new(None),
+            files_put: tokio::sync::Mutex::new(false),
+        };
+        Self {
+            choice: Arc::new(choice),
+        }
+    }
