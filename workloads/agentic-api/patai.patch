diff --git a/crates/patai-eryx-precompile/Cargo.toml b/crates/patai-eryx-precompile/Cargo.toml
new file mode 100644
index 0000000..5b9482f
--- /dev/null
+++ b/crates/patai-eryx-precompile/Cargo.toml
@@ -0,0 +1,14 @@
+# patai's: compiles Eryx's Python runtime for the server's target with the server's own Eryx and Wasmtime, so the
+# runtime it embeds can't be from another Cranelift.
+[package]
+name = "patai-eryx-precompile"
+version = "0.0.0"
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+publish = false
+
+[dependencies]
+eryx.workspace = true
+# Every architecture, so a PC can compile the runtime for the Xavier.
+wasmtime = { version = "48", default-features = false, features = ["all-arch"] }
diff --git a/crates/patai-eryx-precompile/src/main.rs b/crates/patai-eryx-precompile/src/main.rs
new file mode 100644
index 0000000..7ee52b0
--- /dev/null
+++ b/crates/patai-eryx-precompile/src/main.rs
@@ -0,0 +1,25 @@
+//! `patai-eryx-precompile <runtime.wasm> <runtime.cwasm> <target triple>`: Eryx's runtime,
+//! compiled ahead of time for the target, with Cranelift's baseline settings for it.
+
+use std::process::ExitCode;
+
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let [input, output, target] = args.as_slice() else {
+        eprintln!("usage: patai-eryx-precompile <runtime.wasm> <runtime.cwasm> <target triple>");
+        return ExitCode::from(2);
+    };
+    let compiled = std::fs::read(input)
+        .map_err(|error| error.to_string())
+        .and_then(|wasm| {
+            eryx::PythonExecutor::precompile_with_target(&wasm, Some(target)).map_err(|error| error.to_string())
+        })
+        .and_then(|cwasm| std::fs::write(output, cwasm).map_err(|error| error.to_string()));
+    match compiled {
+        Ok(()) => ExitCode::SUCCESS,
+        Err(error) => {
+            eprintln!("patai-eryx-precompile: {error}");
+            ExitCode::FAILURE
+        }
+    }
+}
