+# patai's: compiles Eryx's Python runtime for the server's target with the server's own Eryx and Wasmtime, so the
+# runtime it embeds can't be from another Cranelift.
+[package]
+name = "patai-eryx-precompile"
+version = "0.0.0"
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+publish = false
+
+[dependencies]
+# native-extensions links the packages' WebAssembly extensions, such as NumPy's, into the runtime.
+eryx = { workspace = true, features = ["preinit", "native-extensions", "embedded-stdlib"] }
+# Every architecture, so a PC can compile the runtime for the Xavier.
+wasmtime = { version = "50", default-features = false, features = ["all-arch"] }
+tokio = { workspace = true, features = ["rt", "macros"] }
+
+[lints]
+workspace = true
diff --git a/crates/patai-eryx-precompile/src/main.rs b/crates/patai-eryx-precompile/src/main.rs
new file mode 100644
index 0000000..2475f63
--- /dev/null
+++ b/crates/patai-eryx-precompile/src/main.rs
@@ -0,0 +1,68 @@
+//! `patai-eryx-precompile <site-packages> <runtime.cwasm> <target triple> [module...]`: Eryx's Python runtime with
+//! the standard library and the packages in `<site-packages>`, their WebAssembly extensions (`.so`) linked in,
+//! pre-initialized with `module...` imported, then compiled ahead of time for the target at Cranelift's baseline for
+//! it.
+//!
+//! Pre-initializing runs the guest here, on the build machine, in Wasmtime: it's WebAssembly, so the snapshot is the
+//! same wherever it's taken. Only the compile is for the target. The server mounts the same packages, read-only, at
+//! the same `/site-packages`.
+
+use std::process::ExitCode;
+
+#[tokio::main(flavor = "current_thread")]
+async fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let [site_packages, output, target, imports @ ..] = args.as_slice() else {
+        eprintln!("usage: patai-eryx-precompile <site-packages> <runtime.cwasm> <target triple> [module...]");
+        return ExitCode::from(2);
+    };
+    match run(site_packages, output, target, imports).await {
+        Ok(()) => ExitCode::SUCCESS,
+        Err(error) => {
+            eprintln!("patai-eryx-precompile: {error}");
+            ExitCode::FAILURE
+        }
+    }
+}
+
+async fn run(site_packages: &str, output: &str, target: &str, imports: &[String]) -> Result<(), String> {
+    let stdlib = eryx::embedded_stdlib::EmbeddedStdlib::get().map_err(|error| error.to_string())?;
+    let extensions = extensions(std::path::Path::new(site_packages))?;
+    eprintln!("patai-eryx-precompile: linking {} extensions", extensions.len());
+    let options = eryx::preinit::PreInitOptions::new(stdlib.path())
+        .site_packages(site_packages)
+        .imports(imports.iter().cloned())
+        .extensions(extensions);
+    let preinitialized = eryx::preinit::pre_initialize_with_options(options)
+        .await
+        .map_err(|error| format!("pre-initializing: {error}"))?;
+    let compiled =
+        eryx::PythonExecutor::precompile_with_options(&preinitialized, Some(target), eryx::CpuFeatureLevel::Baseline)
+            .map_err(|error| format!("compiling for {target}: {error}"))?;
+    std::fs::write(output, compiled).map_err(|error| format!("writing {output}: {error}"))
+}
+
+/// Every `.so` below `site_packages`, named by the path the guest's `dlopen` asks for: the same file below
+/// `/site-packages`.
+fn extensions(site_packages: &std::path::Path) -> Result<Vec<eryx::preinit::NativeExtension>, String> {
+    let mut found = Vec::new();
+    let mut pending = vec![site_packages.to_path_buf()];
+    while let Some(dir) = pending.pop() {
+        let entries = std::fs::read_dir(&dir).map_err(|error| format!("reading {}: {error}", dir.display()))?;
+        for entry in entries {
+            let path = entry.map_err(|error| error.to_string())?.path();
+            if path.is_dir() {
+                pending.push(path);
+            } else if path.extension().is_some_and(|extension| extension == "so") {
+                let relative = path.strip_prefix(site_packages).map_err(|error| error.to_string())?;
+                let bytes = std::fs::read(&path).map_err(|error| format!("reading {}: {error}", path.display()))?;
+                found.push(eryx::preinit::NativeExtension::new(
+                    format!("/site-packages/{}", relative.display()),
+                    bytes,
+                ));
+            }
+        }
+    }
+    found.sort_by(|a, b| a.name.cmp(&b.name));
+    Ok(found)
+}
