+/// patai: a container's files and Python state through the real runtime, without the worker's cgroup.
+#[cfg(test)]
+mod container_tests {
+    use super::*;
+
+    fn config() -> CodeInterpreterRuntimeConfig {
+        CodeInterpreterRuntimeConfig {
+            enabled: true,
+            max_fuel: std::num::NonZeroU64::new(50_000_000_000).expect("nonzero"),
+            ..CodeInterpreterRuntimeConfig::default()
+        }
+    }
+
+    fn container(dir: &Path, max_bytes: u64) -> WorkerContainer {
+        std::fs::create_dir_all(dir.join("files")).expect("files dir");
+        WorkerContainer {
+            files_dir: dir.join("files"),
+            state_path: dir.join("state.bin"),
+            max_bytes,
+            max_files: 16,
+        }
+    }
+
+    async fn run(code: &str, container: &WorkerContainer) -> ExecutionOutput {
+        supervise(config(), code.to_owned(), Some(container.clone()))
+            .await
+            .expect("runs")
+    }
+
+    #[tokio::test]
+    async fn variables_and_files_carry_to_the_next_call() {
+        let dir = tempfile::tempdir().expect("temp dir");
+        let container = container(dir.path(), 1024 * 1024);
+        let first = run(
+            "import sqlite3, json\n\
+             x = 41\n\
+             def double(n):\n    return 2 * n\n\
+             db = sqlite3.connect('/mnt/data/work.db')\n\
+             db.execute('create table t(v)')\n\
+             db.executemany('insert into t values (?)', [(i,) for i in range(1000)])\n\
+             db.commit()\n\
+             db.close()\n\
+             open('/mnt/data/out.txt', 'w').write('hi')\n\
+             print('first')",
+            &container,
+        )
+        .await;
+        assert!(matches!(first.status, ExecutionStatus::Completed), "{first:?}");
+        assert_eq!(first.stdout, "first\n");
+        eprintln!("first notes: {:?}", first.notes);
+        assert!(container.files_dir.join("work.db").is_file());
+        assert!(container.state_path.is_file());
+        let second = run(
+            "import sqlite3\n\
+             n = sqlite3.connect('/mnt/data/work.db').execute('select count(*) from t').fetchone()[0]\n\
+             print(x + 1, double(n), open('/mnt/data/out.txt').read())",
+            &container,
+        )
+        .await;
+        assert!(matches!(second.status, ExecutionStatus::Completed), "{second:?}");
+        assert_eq!(second.stdout, "42 2000 hi\n");
+        eprintln!("second notes: {:?}", second.notes);
+    }
+
+    #[tokio::test]
+    async fn mnt_data_is_held_to_its_cap_and_nothing_else_is_writable() {
+        let dir = tempfile::tempdir().expect("temp dir");
+        let container = container(dir.path(), 64 * 1024);
+        let output = run(
+            "import os\n\
+             for path in ['/mnt/data/big.bin', '/mnt/data/../escape.txt', '/etc/x', '/site-packages/x']:\n    \
+                 try:\n        with open(path, 'wb') as f:\n            f.write(b'x' * 100_000)\n        print(path, 'written')\n    \
+                 except OSError as e:\n        print(path, type(e).__name__, e.errno)\n\
+             open('/tmp/scratch.txt', 'w').write('scratch')\n\
+             print(sorted(os.listdir('/mnt/data')), os.listdir('/'))",
+            &container,
+        )
+        .await;
+        eprintln!("{}", output.stdout);
+        assert!(!output.stdout.contains("written"), "{}", output.stdout);
+        assert!(!dir.path().join("escape.txt").exists());
+        let used = super::super::disk::usage(&container.files_dir).expect("usage");
+        assert!(used.bytes <= 64 * 1024, "{used:?}");
+        assert!(!container.files_dir.join("scratch.txt").exists());
+    }
+
+    #[tokio::test]
+    async fn the_packages_import() {
+        if !Path::new(SITE_PACKAGES).is_dir() {
+            eprintln!("skipped: no {SITE_PACKAGES}");
+            return;
+        }
+        let dir = tempfile::tempdir().expect("temp dir");
+        let container = container(dir.path(), 8 * 1024 * 1024);
+        let output = run(
+            "import time\nt0 = time.time()\n\
+             import openpyxl, xlsxwriter, pypdf, mammoth, tabulate, dateutil, pytz, bs4, markdown, pygal\n\
+             t1 = time.time()\n\
+             import sympy, networkx\n\
+             t2 = time.time()\n\
+             from zoneinfo import ZoneInfo\n\
+             print(ZoneInfo('America/Toronto'))\n\
+             wb = openpyxl.Workbook(); wb.active['A1'] = 1; wb.save('/mnt/data/a.xlsx')\n\
+             print(openpyxl.load_workbook('/mnt/data/a.xlsx').active['A1'].value)\n\
+             chart = pygal.Bar(); chart.add('a', [1, 3, 2]); chart.render_to_file('/mnt/data/c.svg')\n\
+             print(tabulate.tabulate([[1, 2]], headers=['a', 'b'], tablefmt='github'))\n\
+             print(sympy.factor(sympy.Symbol('x')**2 - 1), networkx.shortest_path(networkx.path_graph(4), 0, 3))\n\
+             import pickle, numpy as np, pandas as pd\n\
+             df = pd.DataFrame({'k': ['a', 'b', 'a'], 'v': [1, 2, 3]})\n\
+             print(pickle.loads(pickle.dumps(df)).groupby('k')['v'].sum().to_dict())\n\
+             np.save('/mnt/data/a.npy', np.arange(4)); print(np.load('/mnt/data/a.npy').sum())\n\
+             print('preimported %.2f s, sympy+networkx %.2f s' % (t1 - t0, t2 - t1))",
+            &container,
+        )
+        .await;
+        eprintln!("{}\n{}\n{:?}", output.stdout, output.stderr, output.notes);
+        assert!(matches!(output.status, ExecutionStatus::Completed), "{output:?}");
+        assert!(output.stdout.contains("America/Toronto"));
+        assert!(output.stdout.contains("(x - 1)*(x + 1) [0, 1, 2, 3]"));
+        assert!(output.stdout.contains("{'a': 4, 'b': 2}\n6\n"), "{}", output.stdout);
+        assert!(container.files_dir.join("c.svg").is_file());
+    }
+
+    #[tokio::test]
+    async fn unpicklable_variables_are_named_and_the_rest_kept() {
+        let dir = tempfile::tempdir().expect("temp dir");
+        let container = container(dir.path(), 1024 * 1024);
+        let first = run(
+            "import threading\nlock = threading.Lock()\nkept = [1, 2]\ngen = (i for i in range(3))",
+            &container,
+        )
+        .await;
+        eprintln!("notes: {:?}", first.notes);
+        assert_eq!(
+            first.notes,
+            ["Not kept for the next call, as they can't be pickled: gen."]
+        );
+        let second = run("print(kept, 'gen' in globals())", &container).await;
+        assert_eq!(second.stdout, "[1, 2] False\n");
+    }
+
+    #[tokio::test]
+    async fn a_call_that_raises_keeps_the_variables() {
+        let dir = tempfile::tempdir().expect("temp dir");
+        let container = container(dir.path(), 1024 * 1024);
+        let first = run(
+            "rows = [{'region': 'north', 'units': i} for i in range(2000)]",
+            &container,
+        )
+        .await;
+        eprintln!("first notes: {:?}", first.notes);
+        let raised = run(
+            "import os\nnorth = [r for r in rows if r['region'] == 'north']\nnorth[0]['product']",
+            &container,
+        )
+        .await;
+        assert!(matches!(raised.status, ExecutionStatus::Failed), "{raised:?}");
+        eprintln!("raised notes: {:?}", raised.notes);
+        let third = run("print(len(rows), len(north))", &container).await;
+        eprintln!("third: {third:?}");
+        assert_eq!(third.stdout, "2000 2000\n");
+    }
+
+    #[tokio::test]
+    async fn a_variable_that_wont_load_again_is_dropped_and_the_rest_kept() {
+        let dir = tempfile::tempdir().expect("temp dir");
+        let container = container(dir.path(), 1024 * 1024);
+        run(
+            "from openpyxl import Workbook\nwb = Workbook()\nws = wb.active\nws.append([1, 2])\nrows = [1, 2]",
+            &container,
+        )
+        .await;
+        // The restored worksheet pickles to one that won't load: without the check, the next restore would lose rows.
+        let second = run("x = 3", &container).await;
+        eprintln!("second notes: {:?}", second.notes);
+        assert!(
+            second.notes.iter().any(|note| note.contains("ws")),
+            "{:?}",
+            second.notes
+        );
+        let third = run("print(rows, x)", &container).await;
+        assert!(third.notes.is_empty(), "{:?}", third.notes);
+        assert_eq!(third.stdout, "[1, 2] 3\n");
+    }
+
+    #[tokio::test]
+    async fn a_variable_over_the_cap_drops_them_all_and_is_named_once() {
+        let dir = tempfile::tempdir().expect("temp dir");
+        let container = container(dir.path(), 1024 * 1024);
+        run("small = 1", &container).await;
+        let big = run("big = b'x' * (11 * 1024 * 1024)", &container).await;
+        assert_eq!(big.notes.len(), 1, "{:?}", big.notes);
+        assert!(big.notes[0].contains("more than 10 MiB"), "{:?}", big.notes);
+        // Nothing of that call's is kept, so the next call starts with no variables.
+        let next = run("print('small' in globals(), 'big' in globals())", &container).await;
+        assert_eq!(next.stdout, "False False\n");
+    }
+
+    #[tokio::test]
+    async fn sqlite_sorts_bigger_than_its_cache() {
+        let dir = tempfile::tempdir().expect("temp dir");
+        let container = container(dir.path(), 64 * 1024 * 1024);
+        // Past the 2 MB cache, SQLite sorts through a temporary file, which it can't make on WASI.
+        let out = run(
+            "import sqlite3\n\
+             db = sqlite3.connect('/mnt/data/big.db')\n\
+             db.execute('create table t(k, v)')\n\
+             db.executemany('insert into t values (?, ?)', ((i % 1000, 'x' * 40) for i in range(200000)))\n\
+             db.commit()\n\
+             print(db.execute('select k, count(*) from t group by k order by 2 desc, 1 limit 1').fetchone())\n\
+             db.execute('create index tv on t(v, k)')\n\
+             print(sqlite3.connect(':memory:').execute('pragma temp_store').fetchone())",
+            &container,
+        )
+        .await;
+        assert!(matches!(out.status, ExecutionStatus::Completed), "{out:?}");
+        assert_eq!(out.stdout, "(0, 200)\n(2,)\n");
+    }
+
+    #[tokio::test]
+    async fn a_stopped_call_leaves_the_variables_from_before_it() {
+        let dir = tempfile::tempdir().expect("temp dir");
+        let container = container(dir.path(), 1024 * 1024);
+        run("x = 1", &container).await;
+        let stopped = run("x = 2\nwhile True:\n    pass", &container).await;
+        assert!(matches!(stopped.status, ExecutionStatus::Incomplete), "{stopped:?}");
+        assert!(
+            stopped.notes.iter().any(|note| note.contains("stopped")),
+            "{:?}",
+            stopped.notes
+        );
+        assert_eq!(run("print(x)", &container).await.stdout, "1\n");
+    }
+}
