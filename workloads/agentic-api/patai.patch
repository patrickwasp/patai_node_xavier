+    }
+
+    fn execute(
+        &self,
+        code: String,
+        container: Option<provider::WorkerContainer>,
+        _cancellation: Arc<ExecutionCancellation>,
+    ) -> Pin<Box<dyn Future<Output = Result<ExecutionOutput, ToolError>> + Send + '_>> {
+        self.started.lock().expect("lock").push(code.clone());
+        Box::pin(async move {
+            if let Some(container) = container {
+                std::fs::write(container.files_dir.join("out.svg"), b"<svg/>").expect("write");
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(150)).await;
+            Ok(ExecutionOutput {
+                status: ExecutionStatus::Completed,
+                stdout: format!("ran {code}"),
+                stderr: String::new(),
+                notes: Vec::new(),
+            })
+        })
+    }
+}
+
+fn writing_executor(at_once: usize) -> (Arc<CodeInterpreterExecutor>, Arc<WritingProvider>) {
+    let config = CodeInterpreterRuntimeConfig {
+        max_concurrent_guests: std::num::NonZeroUsize::new(at_once).expect("nonzero"),
+        ..CodeInterpreterRuntimeConfig::default()
+    };
+    let provider = Arc::new(WritingProvider {
+        started: std::sync::Mutex::new(Vec::new()),
+    });
+    let executor = CodeInterpreterExecutor::with_provider(config, provider.clone(), test_containers()).expect("ready");
+    (Arc::new(executor), provider)
+}
+
+#[tokio::test]
+async fn a_container_is_its_makers_and_a_run_answers_with_its_files() {
+    let (executor, _) = writing_executor(1);
+    let mine = executor.containers("app:chat");
+    let theirs = executor.containers("key:7");
+    let made = mine
+        .create(Some("chat".to_owned()), None, Vec::new())
+        .await
+        .expect("made");
+    let id = made["id"].as_str().expect("id").to_owned();
+    // Another caller can't find it, list it, run in it, read or delete it.
+    assert_eq!(theirs.get(&id).expect_err("hidden").status, 404);
+    assert_eq!(theirs.list(20, None, false)["data"].as_array().expect("list").len(), 0);
+    assert_eq!(
+        theirs.run(&id, "1".to_owned(), false).await.expect_err("hidden").status,
+        404
+    );
+    assert_eq!(theirs.delete(&id).expect_err("hidden").status, 404);
+    assert_eq!(mine.list(20, None, false)["data"].as_array().expect("list").len(), 1);
+    let ran = mine.run(&id, "print(1)".to_owned(), false).await.expect("ran");
+    assert_eq!(ran["object"], "container.run");
+    assert_eq!(ran["status"], "completed");
+    assert_eq!(ran["stdout"], "ran print(1)");
+    assert_eq!(ran["files"][0]["path"], "/mnt/data/out.svg");
+    let file_id = ran["files"][0]["id"].as_str().expect("file id");
+    assert!(mine.file_content(&id, file_id).is_ok());
+    assert_eq!(theirs.file_content(&id, file_id).expect_err("hidden").status, 404);
+    // A Responses call from another caller can't name it either.
+    let declaration: CodeInterpreterToolParam =
+        serde_json::from_value(serde_json::json!({"container": id})).expect("declaration");
+    let params = CodeInterpreterExecution::new(&declaration, None, "key:7");
+    let refused = executor
+        .execute(
+            "call_1",
+            CODE_INTERPRETER_FUNCTION_NAME,
+            r#"{"code":"print(2)"}"#,
+            &params,
+        )
+        .await;
+    assert!(refused.is_err(), "{refused:?}");
+    let params = CodeInterpreterExecution::new(&declaration, None, "app:chat");
+    assert!(
+        executor
+            .execute(
+                "call_2",
+                CODE_INTERPRETER_FUNCTION_NAME,
+                r#"{"code":"print(2)"}"#,
+                &params
+            )
+            .await
+            .is_ok()
+    );
+}
+
+#[tokio::test]
+async fn a_second_run_waits_its_turn_and_a_background_one_goes_last() {
+    let (executor, provider) = writing_executor(1);
+    let containers = executor.containers("app:chat");
+    let mut ids = Vec::new();
+    for _ in 0..3 {
+        let made = containers.create(None, None, Vec::new()).await.expect("made");
+        ids.push(made["id"].as_str().expect("id").to_owned());
+    }
+    let run = |id: String, code: &'static str, background: bool| {
+        let containers = containers.clone();
+        tokio::spawn(async move { containers.run(&id, code.to_owned(), background).await })
+    };
+    let first = run(ids[0].clone(), "first", false);
+    tokio::time::sleep(std::time::Duration::from_millis(30)).await;
+    let background = run(ids[1].clone(), "background", true);
+    tokio::time::sleep(std::time::Duration::from_millis(30)).await;
+    let second = run(ids[2].clone(), "second", false);
+    for task in [first, background, second] {
+        assert_eq!(task.await.expect("joined").expect("ran")["status"], "completed");
+    }
+    assert_eq!(
+        *provider.started.lock().expect("lock"),
+        ["first", "second", "background"]
+    );
+}
