+/// Run in the guest before a snapshot: drops each global whose pickle doesn't load again, and writes their names as
+/// JSON, with whether one alone pickles to more than Eryx keeps. Eryx's snapshot checks only that each global pickles,
+/// and one that then doesn't load fails the whole restore: an openpyxl worksheet, once restored, pickles to one that
+/// can't be. Each is tried with the C pickler first, which is many times faster for data such as a `DataFrame`, and with
+/// dill, as Eryx pickles, if that fails. The names it skips are Eryx's.
+const DROP_UNRESTORABLE: &str = "\
+import sys as _eryx_patai_sys, json as _eryx_patai_json, pickle as _eryx_patai_pickle, dill as _eryx_patai_dill
+_eryx_patai_dropped = []
+_eryx_patai_too_large = False
