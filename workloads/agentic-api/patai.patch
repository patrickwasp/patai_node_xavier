+impl CodeInterpreterExecution {
+    pub(crate) fn new(param: &CodeInterpreterToolParam, history: Option<&ResponsesInput>, owner: &str) -> Self {
+        let (explicit, file_ids) = match &param.container {
+            CodeInterpreterContainer::Id(id) => (Some(id.clone()), Vec::new()),
+            CodeInterpreterContainer::Auto(auto) => (None, auto.file_ids.clone()),
+        };
