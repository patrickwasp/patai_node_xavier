+/// The container of the conversation's last code interpreter call.
+fn history_container(history: Option<&ResponsesInput>) -> Option<String> {
+    let Some(ResponsesInput::Items(items)) = history else {
+        return None;
+    };
+    items
+        .iter()
+        .rev()
+        .find_map(|item| match item {
+            InOutItem::Input(InputItem::CodeInterpreterCall(call))
+            | InOutItem::Output(OutputItem::CodeInterpreterCall(call)) => Some(call.container_id.clone()),
+            _ => None,
+        })
+        .filter(|id| container::valid_container_id(id))
