+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn store(limits: ContainerLimits) -> (tempfile::TempDir, Arc<ContainerStore>) {
+        let dir = tempfile::tempdir().expect("temp dir");
+        let store = ContainerStore::open(dir.path().join("containers"), limits).expect("store");
+        (dir, Arc::new(store))
+    }
+
+    const LIMITS: ContainerLimits = ContainerLimits {
+        max_containers: 2,
+        max_bytes: 10,
+        max_files: 3,
+        default_idle_minutes: 20,
+    };
+
+    #[test]
+    fn paths_stay_below_the_mount() {
+        assert_eq!(container_path("/mnt/data/a/b.csv").unwrap(), "a/b.csv");
+        assert_eq!(container_path("b.csv").unwrap(), "b.csv");
+        for path in ["", "/", "../x", "a/../../x", "a//b", "/mnt/data/", "a\0b"] {
+            assert!(container_path(path).is_err(), "{path:?}");
+        }
+        assert!(valid_container_id("cntr_0123456789abcdef0123456789abcdef"));
+        for id in [
+            "cntr_x",
+            "cntr_0123456789ABCDEF0123456789abcdef",
+            "../cntr_0123456789abcdef0123456789abcdef",
+        ] {
+            assert!(!valid_container_id(id), "{id}");
+        }
+    }
+
+    #[test]
+    fn files_go_in_within_caps_and_a_run_finds_what_it_made() {
+        let (_dir, store) = store(LIMITS);
+        let container = store.create(Some("analysis".to_owned()), None, "").unwrap();
+        let file = store
+            .add_file(&container.id, "/mnt/data/in.csv", &b"a,b\n"[..])
+            .unwrap();
+        assert_eq!(
+            (file.path.as_str(), file.bytes, file.source),
+            ("in.csv", 4, FileSource::User)
+        );
+        assert!(matches!(
+            store.add_file(&container.id, "big.bin", &[0_u8; 7][..]),
+            Err(ContainerError::Full(_))
+        ));
+        let lease = store.lease(&container.id).unwrap();
+        assert!(matches!(store.lease(&container.id), Err(ContainerError::Busy)));
+        fs::write(lease.files_dir.join("out.txt"), b"done").unwrap();
+        let changed = lease.finish().unwrap();
+        assert_eq!(changed.len(), 1);
+        assert_eq!(
+            (changed[0].path.as_str(), changed[0].source),
+            ("out.txt", FileSource::Assistant)
+        );
+        let meta = store.get(&container.id).unwrap();
+        assert_eq!(meta.files.len(), 2);
+        assert_eq!(meta.files.iter().find(|f| f.path == "in.csv").unwrap().id, file.id);
+        store.delete_file(&container.id, &file.id).unwrap();
+        assert_eq!(store.get(&container.id).unwrap().files.len(), 1);
+    }
+
+    #[test]
+    fn keeps_containers_across_restarts_and_caps_how_many() {
+        let dir = tempfile::tempdir().expect("temp dir");
+        let root = dir.path().join("containers");
+        let store = Arc::new(ContainerStore::open(root.clone(), LIMITS).unwrap());
+        let first = store.create(None, None, "").unwrap();
+        store.create(None, Some(5), "key:2").unwrap();
+        assert!(matches!(store.create(None, None, ""), Err(ContainerError::Full(_))));
+        drop(store);
+        fs::create_dir_all(root.join("not-a-container")).unwrap();
+        let reopened = ContainerStore::open(root.clone(), LIMITS).unwrap();
+        assert!(reopened.get(&first.id).is_ok());
+        assert!(!root.join("not-a-container").exists());
+        assert_eq!(reopened.list(10, None, false, "").0.len(), 1);
+        assert_eq!(reopened.list(10, None, false, "key:2").0.len(), 1);
+        assert!(matches!(
+            reopened.owned(&first.id, "key:2"),
+            Err(ContainerError::NotFound(_))
+        ));
+        assert!(reopened.owned(&first.id, "").is_ok());
+    }
+
+    #[test]
+    fn a_dropped_lease_still_records_the_files() {
+        let (_dir, store) = store(LIMITS);
+        let container = store.create(None, None, "").unwrap();
+        {
+            let lease = store.lease(&container.id).unwrap();
+            fs::write(lease.files_dir.join("partial.txt"), b"x").unwrap();
+        }
+        assert_eq!(store.get(&container.id).unwrap().files.len(), 1);
+        assert!(store.lease(&container.id).is_ok());
+    }
+}
