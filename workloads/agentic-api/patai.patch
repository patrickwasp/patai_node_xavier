+    try:
+        _eryx_patai_pickled = _eryx_patai_pickle.dumps(_eryx_patai_value)
+        _eryx_patai_pickle.loads(_eryx_patai_pickled)
+    except Exception:
+        try:
+            _eryx_patai_pickled = _eryx_patai_dill.dumps(_eryx_patai_value, recurse=True)
+        except Exception:
+            continue
+        try:
+            _eryx_patai_dill.loads(_eryx_patai_pickled)
+        except Exception:
+            _eryx_patai_dropped.append(_eryx_patai_name)
+            del globals()[_eryx_patai_name]
+            continue
+    if len(_eryx_patai_pickled) > MAX_STATE_BYTES:
+        _eryx_patai_too_large = True
+        break
+del _eryx_patai_value, _eryx_patai_pickled
+_eryx_patai_sys.stdout.write(_eryx_patai_json.dumps({'dropped': _eryx_patai_dropped, 'too_large': _eryx_patai_too_large}))
+";
+
+/// What [`DROP_UNRESTORABLE`] found.
+#[derive(serde::Deserialize, Default)]
+struct Checked {
+    dropped: Vec<String>,
+    too_large: bool,
+}
+
+/// The most Eryx keeps of a call's variables, its `MAX_SNAPSHOT_SIZE`, which it doesn't export.
+const MAX_STATE_BYTES: usize = 10 * 1024 * 1024;
+
+const TOO_LARGE: &str = "Variables weren't kept for the next call: they pickle to more than 10 MiB. Save large data \
+                         to /mnt/data instead. Files in /mnt/data were.";
+
+/// Keep the globals for the next call, replacing the last ones only once the new ones are whole.
+async fn save(session: &mut InProcessSession<'_>, path: &Path, notes: &mut Vec<String>) {
+    let check = DROP_UNRESTORABLE.replace("MAX_STATE_BYTES", &MAX_STATE_BYTES.to_string());
+    let checked = match session.execute(&check).await {
+        Ok(checked) => serde_json::from_slice::<Checked>(&checked.stdout).unwrap_or_default(),
+        // Something the call left broke the check, so the snapshot is taken as Eryx takes it.
+        Err(error) if matches!(error.kind(), ErrorKind::PythonException { .. }) => Checked::default(),
+        Err(_) => {
+            notes.push(
+                "This call's variables weren't kept, as checking them took too long: the next call has the ones from \
+                 before it. Files it wrote to /mnt/data were kept."
+                    .to_owned(),
+            );
+            return;
+        }
+    };
+    // One variable alone is more than Eryx keeps, so it would pickle them all again only to refuse them.
+    if checked.too_large {
+        let _ = std::fs::remove_file(path);
+        notes.push(TOO_LARGE.to_owned());
+        return;
+    }
+    match session.snapshot_state().await {
+        Ok(snapshot) => {
+            let mut skipped: Vec<&str> = snapshot.skipped_globals().iter().map(String::as_str).collect();
+            skipped.extend(checked.dropped.iter().map(String::as_str));
+            skipped.sort_unstable();
+            skipped.dedup();
+            if !skipped.is_empty() {
+                notes.push(format!(
+                    "Not kept for the next call, as they can't be pickled: {}.",
+                    skipped.join(", ")
+                ));
+            }
+            let staging = path.with_extension("new");
+            let written = std::fs::write(&staging, snapshot.to_bytes()).and_then(|()| std::fs::rename(&staging, path));
+            if written.is_err() {
+                let _ = std::fs::remove_file(&staging);
+                notes.push("Variables weren't kept for the next call. Files in /mnt/data were.".to_owned());
+            }
+        }
+        Err(error) => {
+            let _ = std::fs::remove_file(path);
+            notes.push(match error.kind() {
+                ErrorKind::Snapshot(message) if message.contains("too large") => TOO_LARGE.to_owned(),
+                _ => "Variables weren't kept for the next call: they couldn't be pickled. Files in /mnt/data were."
+                    .to_owned(),
+            });
+        }
+    }
