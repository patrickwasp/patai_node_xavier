@@ -0,0 +1,396 @@
+//! patai: OpenAI's Containers API for the code interpreter's containers: their files in `/mnt/data` and the Python
+//! state that carry from one call to the next. Off, and answering 404, while the code interpreter is. Each container is
+//! its maker's, as the gateway names a request's caller in `X-Patai-Caller`: nobody else's request sees it. And
+//! patai's runs: `POST /v1/containers/{id}/runs` runs code in one, for a client with a tool loop of its own.
+
+use std::io::{self, Read};
+
+use axum::Json;
+use axum::Router;
+use axum::body::{Body, Bytes};
+use axum::extract::{DefaultBodyLimit, Multipart, Path, Query, Request, State};
+use axum::http::{HeaderMap, StatusCode, header};
+use axum::response::{IntoResponse, Response};
+use axum::routing::{get, post};
+use serde::Deserialize;
+
+use agentic_core::tool::code_interpreter::{Containers, ContainersError};
+
+use crate::app::AppState;
+
+pub(crate) fn router(max_upload_bytes: usize) -> Router<AppState> {
+    Router::new()
+        .route("/v1/containers", get(list).post(create))
+        .route("/v1/containers/{container_id}", get(retrieve).delete(delete))
+        .route(
+            "/v1/containers/{container_id}/files",
+            get(list_files)
+                .post(upload)
+                .layer(DefaultBodyLimit::max(max_upload_bytes)),
+        )
+        .route(
+            "/v1/containers/{container_id}/files/{file_id}",
+            get(retrieve_file).delete(delete_file),
+        )
+        .route("/v1/containers/{container_id}/files/{file_id}/content", get(content))
+        .route("/v1/containers/{container_id}/runs", post(run))
+}
+
+/// Who a request is from, as the node's gateway says, which sets the header over anything a client sent. A request
+/// that didn't come through it has none, and reaches only containers made the same way.
+pub(crate) fn caller(headers: &HeaderMap) -> String {
+    headers
+        .get("x-patai-caller")
+        .and_then(|value| value.to_str().ok())
+        .map(str::to_owned)
+        .unwrap_or_default()
+}
+
+fn failure(status: u16, message: impl Into<String>) -> Response {
+    let status = StatusCode::from_u16(status).unwrap_or(StatusCode::INTERNAL_SERVER_ERROR);
+    let kind = if status.is_server_error() {
+        "server_error"
+    } else {
+        "invalid_request_error"
+    };
+    let body = serde_json::json!({"error": {"message": message.into(), "type": kind, "param": null, "code": null}});
+    (status, Json(body)).into_response()
+}
+
+fn answer(result: Result<serde_json::Value, ContainersError>) -> Response {
+    match result {
+        Ok(value) => Json(value).into_response(),
+        Err(error) => failure(error.status, error.message),
+    }
+}
+
+fn containers(state: &AppState, headers: &HeaderMap) -> Result<Containers, Response> {
+    state
+        .exec_ctx
+        .code_interpreter_containers(&caller(headers))
+        .ok_or_else(|| failure(404, "Containers need the code interpreter, which is off"))
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ExpiresAfter {
+    anchor: String,
+    minutes: u32,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CreateRequest {
+    #[serde(default)]
+    name: Option<String>,
+    #[serde(default)]
+    file_ids: Vec<String>,
+    #[serde(default)]
+    expires_after: Option<ExpiresAfter>,
+}
+
+#[derive(Debug, Deserialize)]
+struct ListQuery {
+    #[serde(default)]
+    limit: Option<usize>,
+    #[serde(default)]
+    after: Option<String>,
+    #[serde(default)]
+    order: Option<String>,
+}
+
+impl ListQuery {
+    fn ascending(&self) -> Result<bool, Response> {
+        match self.order.as_deref() {
+            None | Some("desc") => Ok(false),
+            Some("asc") => Ok(true),
+            Some(_) => Err(failure(400, "order must be asc or desc")),
+        }
+    }
+}
+
+async fn create(State(state): State<AppState>, headers: HeaderMap, body: Bytes) -> Response {
+    let containers = match containers(&state, &headers) {
+        Ok(containers) => containers,
+        Err(response) => return response,
+    };
+    let request: CreateRequest = if body.is_empty() {
+        CreateRequest {
+            name: None,
+            file_ids: Vec::new(),
+            expires_after: None,
+        }
+    } else {
+        match serde_json::from_slice(&body) {
+            Ok(request) => request,
+            Err(error) => return failure(400, format!("Invalid container: {error}")),
+        }
+    };
+    let minutes = match request.expires_after {
+        Some(after) if after.anchor != "last_active_at" => {
+            return failure(400, "expires_after.anchor must be last_active_at");
+        }
+        Some(after) => Some(after.minutes),
+        None => None,
+    };
+    answer(containers.create(request.name, minutes, request.file_ids).await)
+}
+
+async fn list(State(state): State<AppState>, headers: HeaderMap, Query(query): Query<ListQuery>) -> Response {
+    let containers = match containers(&state, &headers) {
+        Ok(containers) => containers,
+        Err(response) => return response,
+    };
+    let ascending = match query.ascending() {
+        Ok(ascending) => ascending,
+        Err(response) => return response,
+    };
+    Json(containers.list(query.limit.unwrap_or(20), query.after.as_deref(), ascending)).into_response()
+}
+
+async fn retrieve(State(state): State<AppState>, headers: HeaderMap, Path(id): Path<String>) -> Response {
+    match containers(&state, &headers) {
+        Ok(containers) => answer(containers.get(&id)),
+        Err(response) => response,
+    }
+}
+
+async fn delete(State(state): State<AppState>, headers: HeaderMap, Path(id): Path<String>) -> Response {
+    match containers(&state, &headers) {
+        Ok(containers) => answer(containers.delete(&id)),
+        Err(response) => response,
+    }
+}
+
+async fn list_files(
+    State(state): State<AppState>,
+    headers: HeaderMap,
+    Path(id): Path<String>,
+    Query(query): Query<ListQuery>,
+) -> Response {
+    let containers = match containers(&state, &headers) {
+        Ok(containers) => containers,
+        Err(response) => return response,
+    };
+    let ascending = match query.ascending() {
+        Ok(ascending) => ascending,
+        Err(response) => return response,
+    };
+    answer(containers.list_files(&id, query.limit.unwrap_or(20), query.after.as_deref(), ascending))
+}
+
+async fn retrieve_file(
+    State(state): State<AppState>,
+    headers: HeaderMap,
+    Path((id, file_id)): Path<(String, String)>,
+) -> Response {
+    match containers(&state, &headers) {
+        Ok(containers) => answer(containers.file(&id, &file_id)),
+        Err(response) => response,
+    }
+}
+
+async fn delete_file(
+    State(state): State<AppState>,
+    headers: HeaderMap,
+    Path((id, file_id)): Path<(String, String)>,
+) -> Response {
+    match containers(&state, &headers) {
+        Ok(containers) => answer(containers.delete_file(&id, &file_id)),
+        Err(response) => response,
+    }
+}
+
+/// A file's bytes, typed by its name so a browser shows an image as one.
+async fn content(
+    State(state): State<AppState>,
+    headers: HeaderMap,
+    Path((id, file_id)): Path<(String, String)>,
+) -> Response {
+    let containers = match containers(&state, &headers) {
+        Ok(containers) => containers,
+        Err(response) => return response,
+    };
+    let (path, name) = match containers.file_content(&id, &file_id) {
+        Ok(found) => found,
+        Err(error) => return failure(error.status, error.message),
+    };
+    let file = match tokio::fs::File::open(&path).await {
+        Ok(file) => file,
+        Err(_) => return failure(404, format!("No file found with id '{file_id}' in this container.")),
+    };
+    let disposition = format!(
+        "attachment; filename=\"{}\"",
+        name.replace(['"', '\\', '\r', '\n'], "_")
+    );
+    (
+        [
+            (header::CONTENT_TYPE, content_type(&name).to_owned()),
+            (header::CONTENT_DISPOSITION, disposition),
+            (header::X_CONTENT_TYPE_OPTIONS, "nosniff".to_owned()),
+        ],
+        Body::from_stream(tokio_util::io::ReaderStream::new(file)),
+    )
+        .into_response()
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RunRequest {
+    code: String,
+}
+
+/// patai: a run in the container, answered when it ends with its status, what it printed, its notes and the files it
+/// made or changed. `X-Patai-Priority: background`, a scheduled task's or another chat's, waits behind the rest.
+async fn run(State(state): State<AppState>, headers: HeaderMap, Path(id): Path<String>, body: Bytes) -> Response {
+    let containers = match containers(&state, &headers) {
+        Ok(containers) => containers,
+        Err(response) => return response,
+    };
+    let request: RunRequest = match serde_json::from_slice(&body) {
+        Ok(request) => request,
+        Err(error) => return failure(400, format!("Invalid run: {error}")),
+    };
+    let background = headers
+        .get("x-patai-priority")
+        .and_then(|value| value.to_str().ok())
+        .is_some_and(|value| value.eq_ignore_ascii_case("background"));
+    answer(containers.run(&id, request.code, background).await)
+}
+
+fn content_type(name: &str) -> &'static str {
+    let lower = name.to_ascii_lowercase();
+    let extension = lower.rsplit('.').next().unwrap_or("");
+    match extension {
+        "png" => "image/png",
+        "jpg" | "jpeg" => "image/jpeg",
+        "gif" => "image/gif",
+        "webp" => "image/webp",
+        // An SVG can carry script: a browser gets it as an image only through an <img>.
+        "svg" => "image/svg+xml",
+        "csv" => "text/csv; charset=utf-8",
+        "txt" | "md" | "log" => "text/plain; charset=utf-8",
+        "json" => "application/json",
+        "pdf" => "application/pdf",
+        "xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+        "docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+        "pptx" => "application/vnd.openxmlformats-officedocument.presentationml.presentation",
+        "zip" => "application/zip",
+        _ => "application/octet-stream",
+    }
+}
+
+/// An upload: a multipart `file`, streamed into the container within its caps, or JSON naming a Files API file.
+async fn upload(State(state): State<AppState>, Path(id): Path<String>, request: Request) -> Response {
+    let containers = match containers(&state, request.headers()) {
+        Ok(containers) => containers,
+        Err(response) => return response,
+    };
+    let is_json = request
+        .headers()
+        .get(header::CONTENT_TYPE)
+        .and_then(|value| value.to_str().ok())
+        .is_some_and(|value| value.starts_with("application/json"));
+    if is_json {
+        let body = match axum::body::to_bytes(request.into_body(), 64 * 1024).await {
+            Ok(body) => body,
+            Err(_) => return failure(400, "Expected JSON with a file_id"),
+        };
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct FromFile {
+            file_id: String,
+        }
+        return match serde_json::from_slice::<FromFile>(&body) {
+            Ok(from) => answer(containers.add_from_files_api(&id, &from.file_id).await),
+            Err(_) => failure(400, "Expected JSON with a file_id"),
+        };
+    }
+    let mut multipart = match Multipart::from_request(request, &state).await {
+        Ok(multipart) => multipart,
+        Err(_) => {
+            return failure(
+                400,
+                "Expected multipart/form-data with a file field, or JSON with a file_id",
+            );
+        }
+    };
+    loop {
+        let mut field = match multipart.next_field().await {
+            Ok(Some(field)) => field,
+            Ok(None) => return failure(400, "Expected a file field"),
+            Err(error) => return failure(error.status().as_u16(), error.body_text()),
+        };
+        if field.name() != Some("file") {
+            continue;
+        }
+        let Some(name) = field.file_name().map(str::to_owned) else {
+            return failure(400, "The file field needs a filename");
+        };
+        let (sender, receiver) = tokio::sync::mpsc::channel(8);
+        let writer = {
+            let containers = containers.clone();
+            let id = id.clone();
+            tokio::task::spawn_blocking(move || containers.add_file(&id, &name, ChunkReader::new(receiver)))
+        };
+        let mut streamed = Ok(());
+        loop {
+            match field.chunk().await {
+                Ok(Some(chunk)) => {
+                    // The writer stops reading at the container's cap, and then no more is sent.
+                    if sender.send(Ok(chunk)).await.is_err() {
+                        break;
+                    }
+                }
+                Ok(None) => break,
+                Err(error) => {
+                    streamed = Err(failure(error.status().as_u16(), error.body_text()));
+                    let _ = sender.send(Err(io::Error::other("upload ended early"))).await;
+                    break;
+                }
+            }
+        }
+        drop(sender);
+        let written = writer.await;
+        if let Err(response) = streamed {
+            return response;
+        }
+        return match written {
+            Ok(result) => answer(result),
+            Err(_) => failure(500, "container storage failed"),
+        };
+    }
+}
+
+use axum::extract::FromRequest as _;
+
+/// The upload's chunks as a blocking reader, for the store's capped copy.
+struct ChunkReader {
+    receiver: tokio::sync::mpsc::Receiver<io::Result<Bytes>>,
+    current: Bytes,
+}
+
+impl ChunkReader {
+    fn new(receiver: tokio::sync::mpsc::Receiver<io::Result<Bytes>>) -> Self {
+        Self {
+            receiver,
+            current: Bytes::new(),
+        }
+    }
+}
+
+impl Read for ChunkReader {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        while self.current.is_empty() {
+            match self.receiver.blocking_recv() {
+                Some(Ok(chunk)) => self.current = chunk,
+                Some(Err(error)) => return Err(error),
+                None => return Ok(0),
+            }
+        }
+        let count = buf.len().min(self.current.len());
+        buf[..count].copy_from_slice(&self.current[..count]);
+        self.current = self.current.slice(count..);
+        Ok(count)
+    }
+}
