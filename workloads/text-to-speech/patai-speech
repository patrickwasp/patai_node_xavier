#!/usr/bin/env python3
"""OpenAI's /v1/audio/speech in Piper's voices or sanoTTS's, on the CPU, one voice for each language in each
(docs/apps.md, Voice).

  patai-speech <manifest.json>    the recipe's manifest, whose voices it speaks in

  POST /v1/audio/speech     {"input": text, "voice": a voice or "auto", "engine": "piper" or "sano", "speed": 0.25 to 4,
                             "language": "auto" or a language, "context": text}: WAV, 16-bit mono
  POST /v1/audio/language   {"input": text, "context": text}: {"language": "es"}, or null where it doesn't say
  GET  /v1/audio/sano/voices/<voice>/<file>    a sano voice's files for sanoTTS's WebAssembly runtime, for a browser
  GET  /health              200 once the engines are loaded

A voice is one in the manifest whose files are in /models. A request that names none, or one that isn't there, such as
OpenAI's "alloy", gets the engine's voice for its language, or for English. With "language": "auto", or the voice
"auto", the text's language picks the engine's voice for it; a language given picks that one's. A language is found
only where the text, or else `context`, says it clearly: otherwise the voice's own reads it. The answer's
Content-Language is the language it was read in, and X-Patai-Voice the voice. WAV is the only format: the image has no
encoder, and every browser plays it. Nothing logs what was said.
"""
import collections
import http.server
import io
import json
import os
import re
import sys
import threading
import wave

import numpy as np
import onnxruntime as ort
from py3langid.langid import MODEL_FILE, LanguageIdentifier

MODELS = "/models"
# OpenAI's own limit on a request's text, and on the context that helps find its language.
LONGEST = 4096
# Piper voices kept loaded, about 100 MiB each. sano's are a few MiB and stay loaded.
KEEP = 2
# Each takes every core it's given: its compose file gives it 4, which leave the chat model's own threads alone.
THREADS = int(os.environ.get("TTS_THREADS", "4"))
# Words and certainty a language needs before it's taken from the text, rather than the voice's own.
SURE_WORDS, SURE = 3, 0.8
ENGINES = ("piper", "sano")

voices = {}
# engine -> language -> voice id
by_language = {engine: {} for engine in ENGINES}
piper = collections.OrderedDict()
sano = {}
# One at a time: each takes every core it's given.
busy = threading.Lock()
finder = None


def options():
    o = ort.SessionOptions()
    o.intra_op_num_threads = THREADS
    o.inter_op_num_threads = 1
    return o


def piper_voice(model):
    """A Piper voice, loaded with the threads the service gets."""
    from piper import PiperConfig, PiperVoice
    if model in piper:
        piper.move_to_end(model)
        return piper[model]
    path = os.path.join(MODELS, model)
    with open(f"{path}.json") as f:
        config = PiperConfig.from_dict(json.load(f))
    found = PiperVoice(session=ort.InferenceSession(path, options(), providers=["CPUExecutionProvider"]),
                       config=config, download_dir=MODELS)
    piper[model] = found
    while len(piper) > KEEP:
        del piper[next(iter(piper))]
    return found


def sano_voice(voice):
    """A sanoTTS voice in NumPy, its files linked under the names sanoTTS reads into a folder on /tmp: English reads
    its own lexicon, every other language espeak-ng's phonemes, which its Piper teacher was trained on."""
    if voice["id"] not in sano:
        import sanotts
        folder = os.path.join("/tmp/sano", voice["id"])
        os.makedirs(folder, exist_ok=True)
        for name, stored in voice["runtime"].items():
            if not os.path.lexists(os.path.join(folder, name)):
                os.symlink(os.path.join(MODELS, stored), os.path.join(folder, name))
        g2p = "lexicon" if voice["locale"].startswith("en") else "espeak"
        sano[voice["id"]] = sanotts.Synthesizer(voice_dir=folder, piperlite_g2p=g2p)
    return sano[voice["id"]]


def language_of(text):
    """The text's language, where it says it clearly, or None."""
    if not isinstance(text, str) or len(re.findall(r"\w+", text)) < SURE_WORDS:
        return None
    found, certainty = finder.classify(text)
    return found if certainty >= SURE else None


def choose(asked, engine, language, text, context):
    """The voice for the text: the one asked for, unless its language says otherwise, in the engine asked for."""
    engine = engine if engine in ENGINES and by_language[engine] else next(e for e in ENGINES if by_language[e])
    own = by_language[engine]
    voice = voices.get(asked) if isinstance(asked, str) else None
    if voice is None or voice["engine"] != engine:
        voice = voices[own.get("en") or next(iter(own.values()))]
    wanted = None
    if isinstance(language, str) and language.split("-")[0] in own:
        wanted = language.split("-")[0]
    elif asked == "auto" or language == "auto":
        wanted = language_of(text) or language_of(context)
    if wanted and wanted in own and wanted != voice["locale"].split("-")[0]:
        voice = voices[own[wanted]]
    return voice


def speak(text, voice, speed):
    """WAV of the text in the voice, at its own rate."""
    if voice["engine"] == "piper":
        from piper import SynthesisConfig
        found = piper_voice(voice["model"])
        out = io.BytesIO()
        with wave.open(out, "wb") as wav:
            found.synthesize_wav(text, wav, SynthesisConfig(length_scale=(found.config.length_scale or 1) / speed))
        return out.getvalue()
    synth = sano_voice(voice)
    pieces = [p for p in re.split(r"(?<=[.!?…])\s+|\n+", text) if p.strip()]
    # A voice's own length scale is its normal speed: a nano voice's is 1, a PiperLite one's in its manifest.
    own = 1.0 if synth.is_nano else synth.pack.duration_length_scale
    rendered = [synth.synthesize(p, duration_length_scale=None if speed == 1 else own / speed) for p in pieces]
    audio = np.concatenate([np.asarray(r.audio, dtype=np.float32).reshape(-1) for r in rendered] or [np.zeros(0)])
    out = io.BytesIO()
    with wave.open(out, "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(synth.sample_rate)
        wav.writeframes((np.clip(np.nan_to_num(audio), -1, 1) * 32767).astype("<i2").tobytes())
    return out.getvalue()


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def answer(self, status, body, kind="application/json", headers=()):
        self.send_response(status)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        for name, value in headers:
            self.send_header(name, value)
        self.end_headers()
        self.wfile.write(body)

    def error(self, status, message, code):
        self.answer(status, json.dumps({"error": {"message": message, "type": "invalid_request_error", "param": None,
                                                  "code": code}}).encode())

    def do_GET(self):
        if self.path == "/health":
            self.answer(200, b'{"status":"ok"}')
            return
        found = re.fullmatch(r"/v1/audio/sano/voices/([a-z0-9-]+)/([A-Za-z0-9_.-]+)", self.path)
        voice = voices.get(found[1]) if found else None
        stored = (voice or {}).get("web", {}).get(found[2]) if found else None
        if not stored:
            self.error(404, "no such path", "unknown_url")
            return
        # Named by the release that pins them, so a browser keeps them until the next.
        with open(os.path.join(MODELS, stored), "rb") as f:
            body = f.read()
        kind = "application/json" if stored.endswith(".json") else "application/octet-stream"
        self.answer(200, body, kind, [("Cache-Control", "public, max-age=31536000, immutable")])

    def asked(self):
        try:
            length = int(self.headers.get("Content-Length") or 0)
            asked = json.loads(self.rfile.read(length)) if 0 < length <= 8 * LONGEST + 4096 else None
        except ValueError:
            asked = None
        if not isinstance(asked, dict):
            self.error(400, "send JSON with input", "invalid_json")
            return None
        text = asked.get("input")
        if not isinstance(text, str) or not text.strip() or len(text) > LONGEST:
            self.error(400, f"input is text of 1 to {LONGEST} characters", "invalid_input")
            return None
        context = asked.get("context")
        if context is not None and (not isinstance(context, str) or len(context) > LONGEST):
            self.error(400, f"context is text of up to {LONGEST} characters", "invalid_context")
            return None
        return asked

    def do_POST(self):
        if self.path == "/v1/audio/language":
            asked = self.asked()
            if asked is not None:
                found = language_of(asked["input"]) or language_of(asked.get("context"))
                self.answer(200, json.dumps({"language": found}).encode())
            return
        if self.path != "/v1/audio/speech":
            self.error(404, "no such path", "unknown_url")
            return
        asked = self.asked()
        if asked is None:
            return
        if asked.get("response_format") not in (None, "wav"):
            self.error(400, "this unit answers in wav", "unsupported_format")
            return
        if asked.get("engine") not in (None, *ENGINES):
            self.error(400, "engine is piper or sano", "invalid_engine")
            return
        speed = asked.get("speed", 1)
        if isinstance(speed, bool) or not isinstance(speed, (int, float)) or not 0.25 <= speed <= 4:
            self.error(400, "speed is 0.25 to 4", "invalid_speed")
            return
        voice = choose(asked.get("voice"), asked.get("engine") or "piper", asked.get("language"), asked["input"],
                       asked.get("context"))
        with busy:
            body = speak(asked["input"], voice, float(speed))
        self.answer(200, body, "audio/wav", [("Content-Language", voice["locale"].split("-")[0]),
                                             ("X-Patai-Voice", voice["id"])])

    def log_message(self, form, *args):
        # The request line only, which has no text in it.
        sys.stderr.write("%s\n" % (form % args))


def main():
    global finder
    with open(sys.argv[1]) as f:
        manifest = json.load(f)
    here = set(os.listdir(MODELS))
    for voice in manifest["voices"]:
        needs = {voice["model"], *voice.get("runtime", {}).values(), *voice.get("web", {}).values()}
        if voice["engine"] == "piper":
            needs.add(f"{voice['model']}.json")
        if needs <= here:
            voices[voice["id"]] = voice
            by_language[voice["engine"]].setdefault(voice["locale"].split("-")[0], voice["id"])
    if not voices:
        sys.exit("patai-speech: no voice's model is in /models")
    finder = LanguageIdentifier.from_model_file(MODEL_FILE, norm_probs=True)
    finder.set_languages(sorted({v["locale"].split("-")[0] for v in voices.values()}))
    # sano's voices load in a fraction of a second each and stay loaded; Piper's English one is ready too.
    for voice in voices.values():
        if voice["engine"] == "sano":
            sano_voice(voice)
    first = voices[by_language["piper"].get("en") or next(iter(voices))]
    speak("Ready.", first, 1.0)
    server = http.server.ThreadingHTTPServer(("0.0.0.0", 8080), Handler)
    print(f"patai-speech: {len(voices)} voices, piper {sorted(by_language['piper'])}, sano "
          f"{sorted(by_language['sano'])}, on :8080", flush=True)
    server.serve_forever()


main()
