#!/usr/bin/env python3
"""OpenAI's /v1/audio/speech from Kokoro's and Piper's voices, on the CPU (docs/apps.md, Voice).

  patai-speech <manifest.json>    the recipe's manifest, whose voices it speaks in

  POST /v1/audio/speech    {"input": text, "voice": a voice or "auto", "speed": 0.25 to 4,
                            "language": "auto" or a locale, "context": text}: WAV, 16-bit mono
  GET  /health             200 once Kokoro and the default voice are loaded

A voice is one in the manifest whose model is in /models. A request that names none, or one that isn't there, such
as OpenAI's "alloy", gets the default. With "language": "auto", or the voice "auto", the text's language decides: the
voice asked for if it speaks it, otherwise that language's default voice. A language is found only where the text,
or else `context`, says it clearly: otherwise it's the voice's own. A locale given reads the text as that locale.
The answer's Content-Language is the locale it was read in. WAV is the only format: the image has no encoder, and
every browser plays it. Nothing logs what was said.
"""
import collections
import functools
import http.server
import io
import json
import os
import re
import sys
import threading
import wave

import numpy as np
import onnxruntime as ort
import spacy
from py3langid.langid import MODEL_FILE, LanguageIdentifier

MODELS = "/models"
# OpenAI's own limit on a request's text, and on the context that helps find its language.
LONGEST = 4096
# Kokoro reads up to 510 phonemes at once and speaks best at 100 to 200, so text goes to it a sentence or so at a
# time, cut at a clause or a space where a sentence is longer than this.
PIECE = 200
# Piper voices kept loaded: about 100 MiB each. Kokoro, which every other voice is a style of, is always loaded.
KEEP = 2
# Each takes every core it's given: its compose file gives it 6, which leave the chat model's own threads alone.
THREADS = int(os.environ.get("TTS_THREADS", "6"))
# Words and certainty a language needs before it's taken from the text, rather than the voice's own.
SURE_WORDS, SURE = 3, 0.8
ESPEAK = {"es-ES": "es", "es-419": "es-419", "fr-FR": "fr-fr", "it-IT": "it", "pt-BR": "pt-br", "pt-PT": "pt",
          "de-DE": "de", "pl-PL": "pl"}
NAME = re.compile(r"[a-z0-9][a-z0-9-]{0,63}")

voices, defaults = {}, {}
kokoro = None
piper = collections.OrderedDict()
# One at a time: each takes every core it's given.
busy = threading.Lock()
default = ""
finder = None


def options():
    o = ort.SessionOptions()
    o.intra_op_num_threads = THREADS
    o.inter_op_num_threads = 1
    # Without its arena, what a long sentence took is given back: with it, a node keeps its peak.
    o.enable_cpu_mem_arena = False
    return o


class Kokoro:
    """Kokoro-82M through ONNX Runtime, with misaki's phonemes: its own lexicon and spaCy for English, espeak-ng for
    the rest, as Kokoro was trained on."""
    RATE = 24000

    def __init__(self, model, tokenizer):
        self.session = ort.InferenceSession(model, options(), providers=["CPUExecutionProvider"])
        with open(tokenizer) as f:
            self.vocab = json.load(f)["model"]["vocab"]
        self.styles = {}

    def style(self, pack):
        if pack not in self.styles:
            self.styles[pack] = np.fromfile(os.path.join(MODELS, pack), dtype=np.float32).reshape(-1, 1, 256)
        return self.styles[pack]

    @functools.cache
    def g2p(self, locale):
        """A reader of text into Kokoro's phonemes, made once for each locale."""
        if locale in ("en-US", "en-GB"):
            from misaki import en, espeak
            british = locale == "en-GB"
            reader = en.G2P(trf=False, british=british, fallback=espeak.EspeakFallback(british=british), unk="")
        else:
            from misaki import espeak
            reader = espeak.EspeakG2P(language=ESPEAK[locale])
        return lambda text: reader(text)[0]

    def speak(self, text, voice, speed):
        ids = [self.vocab[c] for c in self.g2p(voice["locale"])(text) if c in self.vocab][:510]
        if not ids:
            return np.zeros(0, dtype=np.float32)
        audio = self.session.run(None, {"input_ids": np.array([[0, *ids, 0]], dtype=np.int64),
                                        "style": self.style(voice["pack"])[len(ids) - 1],
                                        "speed": np.array([speed], dtype=np.float32)})[0]
        return audio.reshape(-1)


def piper_voice(model):
    """A Piper voice, loaded with the threads the others get."""
    from piper import PiperConfig, PiperVoice
    if model in piper:
        piper.move_to_end(model)
        return piper[model]
    path = os.path.join(MODELS, model)
    with open(f"{path}.json") as f:
        config = PiperConfig.from_dict(json.load(f))
    found = PiperVoice(session=ort.InferenceSession(path, options(), providers=["CPUExecutionProvider"]),
                       config=config, download_dir=MODELS)
    piper[model] = found
    while len(piper) > KEEP:
        del piper[next(iter(piper))]
    return found


def pieces(text):
    """The text in sentences, each cut at a clause or a space where it's longer than PIECE."""
    out = []
    for sentence in re.split(r"(?<=[.!?…])\s+|\n+", text):
        sentence = sentence.strip()
        while len(sentence) > PIECE:
            cut = max(sentence.rfind(mark, 0, PIECE) for mark in (", ", "; ", ": ", " – ", " — "))
            cut = cut + 1 if cut > PIECE // 3 else sentence.rfind(" ", 0, PIECE)
            cut = cut if cut > 0 else PIECE
            out.append(sentence[:cut].strip())
            sentence = sentence[cut:].strip()
        if sentence:
            out.append(sentence)
    return out


def language_of(text):
    """The text's language, where it says it clearly, or None."""
    if len(re.findall(r"\w+", text)) < SURE_WORDS:
        return None
    found, certainty = finder.classify(text)
    return found if certainty >= SURE else None


def choose(asked, language, text, context):
    """The voice for the text: the one asked for, or the default, unless its language says otherwise."""
    voice = voices[asked if isinstance(asked, str) and asked in voices else default]
    if isinstance(language, str) and language in defaults:
        if language not in (voice["locale"], voice["locale"].split("-")[0]):
            voice = voices[defaults[language]]
    elif asked == "auto" or language == "auto":
        found = language_of(text) or (language_of(context) if context else None)
        if found and found != voice["locale"].split("-")[0]:
            voice = voices[defaults[found]]
    return voice


def speak(text, voice, speed):
    """WAV of the text in the voice: Kokoro's 24 kHz or the Piper voice's own rate."""
    if voice["engine"] == "piper":
        from piper import SynthesisConfig
        found = piper_voice(voice["model"])
        out = io.BytesIO()
        with wave.open(out, "wb") as wav:
            found.synthesize_wav(text, wav, SynthesisConfig(length_scale=(found.config.length_scale or 1) / speed))
        return out.getvalue()
    audio = np.concatenate([kokoro.speak(piece, voice, speed) for piece in pieces(text)] or [np.zeros(0)])
    out = io.BytesIO()
    with wave.open(out, "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(Kokoro.RATE)
        wav.writeframes((np.clip(audio, -1, 1) * 32767).astype("<i2").tobytes())
    return out.getvalue()


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def answer(self, status, body, kind="application/json", headers=()):
        self.send_response(status)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        for name, value in headers:
            self.send_header(name, value)
        self.end_headers()
        self.wfile.write(body)

    def error(self, status, message, code):
        self.answer(status, json.dumps({"error": {"message": message, "type": "invalid_request_error", "param": None,
                                                  "code": code}}).encode())

    def do_GET(self):
        if self.path == "/health":
            self.answer(200, b'{"status":"ok"}')
        else:
            self.error(404, "no such path", "unknown_url")

    def do_POST(self):
        if self.path != "/v1/audio/speech":
            self.error(404, "no such path", "unknown_url")
            return
        try:
            length = int(self.headers.get("Content-Length") or 0)
            asked = json.loads(self.rfile.read(length)) if 0 < length <= 8 * LONGEST + 4096 else None
        except ValueError:
            asked = None
        if not isinstance(asked, dict):
            self.error(400, "send JSON with input", "invalid_json")
            return
        text = asked.get("input")
        if not isinstance(text, str) or not text.strip() or len(text) > LONGEST:
            self.error(400, f"input is text of 1 to {LONGEST} characters", "invalid_input")
            return
        context = asked.get("context")
        if context is not None and (not isinstance(context, str) or len(context) > LONGEST):
            self.error(400, f"context is text of up to {LONGEST} characters", "invalid_context")
            return
        if asked.get("response_format") not in (None, "wav"):
            self.error(400, "this unit answers in wav", "unsupported_format")
            return
        speed = asked.get("speed", 1)
        if isinstance(speed, bool) or not isinstance(speed, (int, float)) or not 0.25 <= speed <= 4:
            self.error(400, "speed is 0.25 to 4", "invalid_speed")
            return
        voice = choose(asked.get("voice"), asked.get("language"), text, context)
        with busy:
            body = speak(text, voice, float(speed))
        self.answer(200, body, "audio/wav", [("Content-Language", voice["locale"]), ("X-Patai-Voice", voice["id"])])

    def log_message(self, form, *args):
        # The request line only, which has no text in it.
        sys.stderr.write("%s\n" % (form % args))


def main():
    global default, kokoro, finder
    with open(sys.argv[1]) as f:
        manifest = json.load(f)
    here = set(os.listdir(MODELS))
    for voice in manifest["voices"]:
        if {voice["model"], f"{voice['model']}.json", voice.get("pack", voice["model"])} <= here:
            voices[voice["id"]] = dict(voice, engine="kokoro" if voice.get("pack") else "piper")
    # Each locale's default, then each language's, the first named of each, then any voice of it.
    for flagged in (True, False):
        for voice in voices.values():
            for key in (voice["locale"], voice["locale"].split("-")[0]):
                if bool(voice.get("default")) >= flagged:
                    defaults.setdefault(key, voice["id"])
    for voice in voices.values():
        if voice["engine"] == "kokoro" and kokoro is None:
            # Its vocabulary is beside it, as a Piper voice's configuration is.
            kokoro = Kokoro(os.path.join(MODELS, voice["model"]), os.path.join(MODELS, f"{voice['model']}.json"))
    if not voices:
        sys.exit("patai-speech: no voice's model is in /models")
    default = defaults.get("en-US") or next(iter(voices))
    # misaki loads spaCy's English for each reader: one copy serves both.
    load, loaded = spacy.load, {}

    def load_once(name, enable=()):
        key = (name, tuple(enable))
        if key not in loaded:
            loaded[key] = load(name, enable=list(enable))
        return loaded[key]

    spacy.load = load_once
    finder = LanguageIdentifier.from_model_file(MODEL_FILE, norm_probs=True)
    finder.set_languages(sorted({v["locale"].split("-")[0] for v in voices.values()}))
    # Every locale's reader, and Kokoro's first run, ready before the first request: British English's lexicon alone
    # takes seconds to load.
    for voice in voices.values():
        if voice["engine"] == "kokoro":
            kokoro.g2p(voice["locale"])
    speak("Ready.", voices[default], 1.0)
    server = http.server.ThreadingHTTPServer(("0.0.0.0", 8080), Handler)
    print(f"patai-speech: {len(voices)} voices, {default} by default, on :8080", flush=True)
    server.serve_forever()


main()
