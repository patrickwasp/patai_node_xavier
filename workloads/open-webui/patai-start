#!/usr/bin/env python3
"""Open WebUI's start on a node (docs/apps.md, The Chat app), before its own start.sh.

Open WebUI keeps its settings in its database from its first start, and then ignores the environment. An owner's
changes in its admin pages are theirs to keep, but what the node decides is taken from the environment at every start:
where the model, embeddings, search, images and voice are, which of them are on, where code runs, and the terminal.
Those settings are removed from the database first, and Open WebUI fills them in again from the environment.

Once the model answers through the gateway for apps, and again whenever it changes, it gives the model its defaults in
Open WebUI's settings for it. None of the tools for Open WebUI's calendar, automations, notes, tasks and skills: those
were 3,200 of the 5,300 tokens of tools ahead of every chat, and a chat on the node needs none of them. And what a new
chat starts with: the code interpreter, web search while the Search API is on, images while the Images API is, and the
node's terminal while the Terminal API is. Those follow the APIs, unless an owner changes one in Open WebUI's settings
for the model, which stays theirs. Code runs in the person's browser, in Pyodide, so nothing a model writes runs on the
node.

Then it fills the model's cache with what a new chat sends ahead of its first message, for the APIs that are on, so the
first doesn't wait to read it (patai_docs notes/prefix-caching.md). Never otherwise: a request takes one of the model's
slots, and could push out the conversation someone is having.

  patai-start <command...>     the above, then the command: Open WebUI's start.sh
  patai-start warm             one round of warming, now, and what it read
"""
import json
import os
import sys
import time
import urllib.request

import psycopg2

# What Open WebUI puts ahead of a new chat's first message, for the APIs that are on, as its requests send it.
WARM = "/usr/local/share/patai/warm-tools.json"

# The node's model's defaults in Open WebUI: built-in tool categories turned off, and what a new chat starts with, by
# the APIs that turn each on.
TOOLS_OFF = ("calendar", "automations", "notes", "tasks", "skills")
FEATURES = (("search", "web_search"), ("images", "image_generation"))
# The node's terminal, as Open WebUI's connection to it is called.
TERMINAL = "node"


def apis_on():
    """The app's APIs that are on, from patai-workload."""
    return os.environ.get("PATAI_APIS", "").split(",")


def chosen():
    """What a new chat starts with, for the APIs that are on."""
    apis = apis_on()
    return {"defaultFeatureIds": ["code_interpreter"] + [feature for api, feature in FEATURES if api in apis],
            "terminalId": TERMINAL if "terminal" in apis else None}

# The node's settings, by their keys in Open WebUI's config table: whole keys, or every key under one ending in . or _.
NODE = ("openai.", "ollama.", "direct.enable", "rag.embedding_engine", "rag.embedding_model",
        "rag.embedding_query_prefix", "rag.embedding_content_prefix", "rag.openai.", "web.search.enable",
        "web.search.engine", "web.search.searxng_", "image_generation.", "images.edit.", "code_interpreter.engine",
        "code_execution.engine", "terminal_server.", "audio.stt.engine", "audio.stt.model", "audio.stt.openai.",
        "audio.tts.engine", "audio.tts.model", "audio.tts.openai.")


def gateway(path, body=None, timeout=60):
    request = urllib.request.Request(os.environ["OPENAI_API_BASE_URL"] + path, json.dumps(body).encode() if body else None,
                                     {"Authorization": "Bearer " + os.environ["OPENAI_API_KEY"],
                                      "Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as answer:
        return json.load(answer)


def connect():
    # Postgres may still be starting.
    for attempt in range(60):
        try:
            return psycopg2.connect(os.environ["DATABASE_URL"], connect_timeout=5)
        except psycopg2.OperationalError:
            if attempt == 59:
                raise
            time.sleep(2)


def defaults(model):
    """The model's defaults in Open WebUI's row for it, under what's there: an owner's choice in its settings stays."""
    db = connect()
    try:
        with db, db.cursor() as cursor:
            cursor.execute("SELECT meta FROM model WHERE id = %s", (model,))
            row = cursor.fetchone()
            meta = json.loads(row[0] or "{}") if row else {}
            before = json.dumps(meta, sort_keys=True)
            tools = meta.setdefault("builtinTools", {})
            for category in TOOLS_OFF:
                tools.setdefault(category, False)
            # What the node set last is kept beside, so a value an owner has changed since is told apart, and stays.
            last = meta.get("patai")
            mine = dict(last or {})
            for key, value in chosen().items():
                if last is None or key not in last or meta.get(key) == last[key]:
                    if value is None:
                        meta.pop(key, None)
                    else:
                        meta[key] = value
                    mine[key] = value
            meta["patai"] = mine
            now = int(time.time())
            if row and json.dumps(meta, sort_keys=True) != before:
                cursor.execute("UPDATE model SET meta = %s, updated_at = %s WHERE id = %s", (json.dumps(meta), now, model))
            elif not row:
                # A row needs an owner, and Open WebUI makes the first at its first start.
                cursor.execute("SELECT id FROM \"user\" WHERE role = 'admin' ORDER BY created_at LIMIT 1")
                owner = cursor.fetchone()
                if not owner:
                    raise ValueError("no owner yet")
                cursor.execute("INSERT INTO model (id, user_id, name, params, meta, is_active, created_at, updated_at)"
                               " VALUES (%s, %s, %s, '{}', %s, true, %s, %s)",
                               (model, owner[0], model, json.dumps(meta), now, now))
    finally:
        db.close()


def warm(model):
    """The model's cache with what a new chat sends, for the APIs that are on, ahead of a word it then forgets. One set,
    so the model's other slot is left for a conversation."""
    with open(WARM) as f:
        known = json.load(f)
    on = sorted(api for api in ("search", "images", "terminal") if api in apis_on())
    each = next((each for each in known["sets"] if sorted(each["apis"]) == on), None)
    if each is None:
        print(f"patai-start: nothing to warm {model} with for {', '.join(on)}", flush=True)
        return
    out = gateway("/chat/completions", {"model": model, "messages": each["messages"] + [{"role": "user", "content": "Hi"}],
                                        "tools": each["tools"], "max_tokens": 1}, timeout=600)
    timings = out.get("timings") or {}
    print(f"patai-start: warmed {model} for {each['name']}: {timings.get('prompt_n')} tokens read, "
          f"{timings.get('cache_n')} kept", flush=True)


def keep_warm():
    """Readies the model once it answers, and again when it changes. Whatever goes wrong waits for the next minute."""
    ready = None
    while True:
        try:
            model = gateway("/models")["data"][0]["id"]
            if model != ready:
                defaults(model)
                warm(model)
                ready = model
        except (OSError, ValueError, KeyError, IndexError, psycopg2.Error):
            pass
        time.sleep(60)


def main():
    if sys.argv[1:] == ["warm"]:
        warm(gateway("/models")["data"][0]["id"])
        return
    apis = apis_on()
    os.environ["ENABLE_WEB_SEARCH"] = "true" if "search" in apis else "false"
    os.environ["ENABLE_IMAGE_GENERATION"] = "true" if "images" in apis else "false"
    os.environ["ENABLE_IMAGE_EDIT"] = "false"
    # Voice through the gateway, at the address and key compose.yaml gives. Without speech to text, the microphone says
    # there's no engine, as the slim image has none of its own; without speech, the browser reads aloud. The voice an
    # owner picks in Open WebUI stays theirs, and none is the node's default.
    os.environ["AUDIO_STT_ENGINE"] = "openai" if "transcription" in apis else ""
    os.environ["AUDIO_STT_MODEL"] = "whisper"
    os.environ["AUDIO_TTS_ENGINE"] = "openai" if "speech" in apis else ""
    os.environ["AUDIO_TTS_MODEL"] = "piper"
    os.environ["AUDIO_TTS_VOICE"] = ""
    # Each person's own, which the gateway starts and tells apart by Open WebUI's X-User-Id, for everyone signed in.
    terminal = [{"id": TERMINAL, "name": "Terminal", "url": "http://patai-gateway:18000/terminal", "path": "/openapi.json",
                 "key": os.environ["OPENAI_API_KEY"], "auth_type": "bearer", "enabled": True,
                 "config": {"access_grants": [{"principal_type": "user", "principal_id": "*", "permission": "read"}]}}]
    os.environ["TERMINAL_SERVER_CONNECTIONS"] = json.dumps(terminal if "terminal" in apis else [])

    db = connect()
    try:
        with db, db.cursor() as cursor:
            cursor.execute("SELECT to_regclass('public.config')")
            # None before Open WebUI's first start has made its tables.
            if cursor.fetchone()[0]:
                removed = 0
                for key in NODE:
                    if key.endswith((".", "_")):
                        cursor.execute("DELETE FROM config WHERE left(key, %s) = %s", (len(key), key))
                    else:
                        cursor.execute("DELETE FROM config WHERE key = %s", (key,))
                    removed += cursor.rowcount
                print(f"patai-start: {removed} of the node's settings taken from the environment again", flush=True)
    finally:
        db.close()
    if os.fork() == 0:
        keep_warm()
    os.execvp(sys.argv[1], sys.argv[1:])


main()
