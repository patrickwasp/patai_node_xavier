#!/usr/bin/env python3
"""OpenAI's /v1/audio/speech from Piper's voices, on the CPU (docs/apps.md, Voice).

  patai-speech <voice.onnx> <voice.onnx.json>    the default voice, which it loads first

  POST /v1/audio/speech    {"input": text, "voice": a voice, "speed": 0.25 to 4}: WAV, 16-bit mono
  GET  /health             200 once the default voice is loaded

A voice is one of the .onnx files in /models, by its name without .onnx. A request that names none, or one that isn't
there, such as OpenAI's "alloy", gets the default. WAV is the only format: the image has no encoder, and Open WebUI and
every browser play it. Nothing logs what was said.
"""
import collections
import http.server
import io
import json
import os
import re
import sys
import threading
import wave

from piper import PiperVoice, SynthesisConfig

MODELS = "/models"
# OpenAI's own limit on a request's text.
LONGEST = 4096
# Voices kept loaded, the default among them: about 100 MiB each.
KEEP = 2
NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,99}")

loaded = collections.OrderedDict()
# One at a time: each takes every core it's given.
busy = threading.Lock()
default = ""


def voice(name):
    """The voice by its name, loaded, or the default's."""
    name = name.removesuffix(".onnx") if isinstance(name, str) else ""
    if not NAME.fullmatch(name) or not os.path.isfile(os.path.join(MODELS, name + ".onnx")):
        name = default
    if name in loaded:
        loaded.move_to_end(name)
        return loaded[name]
    found = PiperVoice.load(os.path.join(MODELS, name + ".onnx"))
    loaded[name] = found
    while len(loaded) > KEEP:
        oldest = next(iter(loaded))
        if oldest == default:
            loaded.move_to_end(oldest)
            oldest = next(iter(loaded))
        del loaded[oldest]
    return found


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def answer(self, status, body, kind="application/json"):
        self.send_response(status)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def error(self, status, message, code):
        self.answer(status, json.dumps({"error": {"message": message, "type": "invalid_request_error", "param": None,
                                                  "code": code}}).encode())

    def do_GET(self):
        if self.path == "/health":
            self.answer(200, b'{"status":"ok"}')
        else:
            self.error(404, "no such path", "unknown_url")

    def do_POST(self):
        if self.path != "/v1/audio/speech":
            self.error(404, "no such path", "unknown_url")
            return
        try:
            length = int(self.headers.get("Content-Length") or 0)
            asked = json.loads(self.rfile.read(length)) if 0 < length <= 4 * LONGEST + 4096 else None
        except ValueError:
            asked = None
        if not isinstance(asked, dict):
            self.error(400, "send JSON with input", "invalid_json")
            return
        text = asked.get("input")
        if not isinstance(text, str) or not text.strip() or len(text) > LONGEST:
            self.error(400, f"input is text of 1 to {LONGEST} characters", "invalid_input")
            return
        if asked.get("response_format") not in (None, "wav"):
            self.error(400, "this unit answers in wav", "unsupported_format")
            return
        speed = asked.get("speed", 1)
        if isinstance(speed, bool) or not isinstance(speed, (int, float)) or not 0.25 <= speed <= 4:
            self.error(400, "speed is 0.25 to 4", "invalid_speed")
            return
        with busy:
            found = voice(asked.get("voice"))
            out = io.BytesIO()
            with wave.open(out, "wb") as wav:
                found.synthesize_wav(text, wav, SynthesisConfig(length_scale=(found.config.length_scale or 1) / speed))
        self.answer(200, out.getvalue(), "audio/wav")

    def log_message(self, form, *args):
        # The request line only, which has no text in it.
        sys.stderr.write("%s\n" % (form % args))


def main():
    global default
    path, config = sys.argv[1:3]
    default = os.path.basename(path).removesuffix(".onnx")
    loaded[default] = PiperVoice.load(path, config)
    server = http.server.ThreadingHTTPServer(("0.0.0.0", 8080), Handler)
    print(f"patai-speech: {default} on :8080", flush=True)
    server.serve_forever()


main()
