  "profile": "standard",
  "profiles": {
    "standard": {
      "about": "Context shared by up to 4 requests at once; llama-server's cache of past prompts in memory capped at 2 GiB, and each request's context checkpoints at 6, 32k apart, which keeps a system prompt for new conversations and a long one's memory bounded. Measured with the 7B model",
      "env": {
        "LLAMA_ARG_CACHE_RAM": "2048",
        "LLAMA_ARG_CTX_CHECKPOINTS": "6",
        "LLAMA_ARG_CHECKPOINT_MIN_SPACING_NT": "32768"
      },
      "memory_mib": 9892
    }
  },
  "settings": [
    {
      "name": "context",
      "title": "Context",
      "about": "Tokens shared by the requests at once. Longer takes more memory.",
      "type": "int",
      "choices": [4096, 8192, 16384, 32768, 65536, 131072],
      "unit": "tokens",
      "default": 65536,
      "env": "LLAMA_CONTEXT"
    },
    {
      "name": "parallel",
      "title": "Requests at once",
      "about": "Each gets an equal share of the context.",
      "type": "int",
      "min": 1,
      "max": 4,
      "default": 2,
      "env": "LLAMA_ARG_N_PARALLEL"
    },
    {
      "name": "thinking",
      "title": "Thinking",
      "about": "Whether a model that can think does before it answers.",
      "type": "choice",
      "choices": ["auto", "on", "off"],
      "default": "auto",
      "env": "LLAMA_ARG_REASONING"
    },
    {
      "name": "effort",
      "title": "Thinking effort",
      "about": "For a model that has levels, such as gpt-oss.",
      "type": "choice",
      "choices": ["default", "low", "medium", "high"],
      "default": "default",
      "env": "LLAMA_ARG_REASONING_EFFORT"
    },
    {
      "name": "think_budget",
      "title": "Thinking budget",
      "about": "Tokens before an answer. -1 for no limit.",
      "type": "int",
      "min": -1,
      "max": 65536,
      "unit": "tokens",
      "default": -1,
      "env": "LLAMA_ARG_THINK_BUDGET"
    },
    {
      "name": "temperature",
      "title": "Temperature",
      "about": "For requests that don't set their own.",
      "type": "number",
      "min": 0,
      "max": 2,
      "default": null,
      "env": "LLAMA_ARG_TEMPERATURE"
    },
    {
