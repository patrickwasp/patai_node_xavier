#!/usr/bin/env python3
"""Put every pinned model whose manifest names a mirror into this repo's `models` release, in pieces of PIECE bytes,
<name>.000 on, as patai-fetch takes them. Each file is read from its own address in ranges, several at once, hashed as
it goes, and its pieces uploaded as they're done. A file that doesn't match its pin has its pieces taken down again.
Pieces already there are kept, so it carries on from where it stopped. Runs in GitHub Actions
(.github/workflows/mirror-models.yml), so the models never pass through anyone's own connection.

  scripts/mirror-models [name...]      needs gh, logged in with write access to the repo
"""
import concurrent.futures, glob, hashlib, json, os, subprocess, sys, tempfile, urllib.request

PIECE = 1 << 30
RANGE = 64 << 20
AT_ONCE = 8
RELEASE = "models"
HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def targets():
    for path in sorted(glob.glob(f"{HERE}/workloads/*/manifest.json")):
        with open(path) as f:
            manifest = json.load(f)
        for model in manifest.get("models") or []:
            for item in [model, *(model.get("files") or [])]:
                if item.get("mirror"):
                    yield item


def assets():
    out = subprocess.run(["gh", "release", "view", RELEASE, "--json", "assets"], capture_output=True, text=True, check=True)
    return {a["name"]: a["size"] for a in json.loads(out.stdout)["assets"]}


def get(url, start, end):
    request = urllib.request.Request(url, headers={"Range": f"bytes={start}-{end}", "User-Agent": "patai-mirror"})
    for attempt in range(5):
        try:
            with urllib.request.urlopen(request, timeout=120) as answer:
                if answer.status != 206:
                    raise RuntimeError(f"{url} doesn't send part of a file")
                data = answer.read()
            if len(data) == end - start + 1:
                return data
        except (OSError, RuntimeError) as error:
            if attempt == 4:
                raise
            print(f"  retrying {start}-{end}: {error}", flush=True)
    raise RuntimeError(f"{url} kept sending the wrong length")


def mirror(item, have, folder):
    name, size, url = item["name"], item["size"], item["url"]
    pieces = [f"{name}.{number:03d}" for number in range((size + PIECE - 1) // PIECE)]
    if all(have.get(p) == min(PIECE, size - i * PIECE) for i, p in enumerate(pieces)):
        print(f"{name}: there", flush=True)
        return
    print(f"{name}: {size / 1e9:.1f} GB in {len(pieces)} pieces from {url}", flush=True)
    sha256, uploaded = hashlib.sha256(), []
    with concurrent.futures.ThreadPoolExecutor(AT_ONCE) as pool:
        for number, piece in enumerate(pieces):
            start = number * PIECE
            end = min(start + PIECE, size) - 1
            spans = [(s, min(s + RANGE, end + 1) - 1) for s in range(start, end + 1, RANGE)]
            path = os.path.join(folder, piece)
            with open(path, "wb") as f:
                for data in pool.map(lambda span: get(url, *span), spans):
                    sha256.update(data)
                    f.write(data)
            if have.get(piece) != end - start + 1:
                subprocess.run(["gh", "release", "upload", RELEASE, path, "--clobber"], check=True)
                uploaded.append(piece)
            os.remove(path)
            print(f"  {piece} done", flush=True)
    if sha256.hexdigest() != item["sha256"]:
        for piece in uploaded:
            subprocess.run(["gh", "release", "delete-asset", RELEASE, piece, "--yes"], check=False)
        sys.exit(f"{name}: what {url} sent doesn't match its pin")
    print(f"{name}: mirrored and matches", flush=True)


def main():
    wanted = set(sys.argv[1:])
    have = assets()
    with tempfile.TemporaryDirectory() as folder:
        for item in targets():
            if not wanted or item["name"] in wanted:
                mirror(item, have, folder)


main()
