#!/usr/bin/env python3
"""Put every pinned model whose manifest names a mirror into Wasupu's bucket, as a whole file at
models/<sha256>/<name>, with its licence and notices beside it (docs/apps.md, Models). Runs in GitHub Actions
(.github/workflows/mirror-models.yml), so the models never pass through anyone's own connection.

Each file is read from its own address in ranges of PART bytes, several at once, and each range is uploaded as a
part of one multipart upload while the file is hashed in order. If what came doesn't match the pin, the upload is
aborted and nothing is left. A file already in the bucket is left alone: it is named by its hash, so it is only ever
put there once it matched. A run that stopped leaves its upload open, and the next one carries on from it: the parts
already uploaded are read again from the address only to hash them, each checked against the MD5 the bucket holds
for it, and the rest are uploaded.

Objects are public-read, as nodes fetch with no credential, and the bucket can't be listed.

  scripts/mirror-models [name...]      every pinned model with a mirror, or only these files
  needs boto3, and the bucket's S3 keys in WASUPU_OVH_XAVIER_ROGUE_S3_ACCESS_KEY and _SECRET_KEY
"""
import base64, collections, concurrent.futures, glob, hashlib, json, os, sys, urllib.error, urllib.request

import boto3
import botocore.config

BUCKET = "wasupu-xavier-rogue"
ENDPOINT = "https://s3.bhs.io.cloud.ovh.net"
PUBLIC = f"https://{BUCKET}.s3.bhs.io.cloud.ovh.net"
PART = 64 << 20
AT_ONCE = 8
TRIES = 5
HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

s3 = boto3.client(
    "s3", endpoint_url=ENDPOINT, region_name="bhs",
    aws_access_key_id=os.environ["WASUPU_OVH_XAVIER_ROGUE_S3_ACCESS_KEY"],
    aws_secret_access_key=os.environ["WASUPU_OVH_XAVIER_ROGUE_S3_SECRET_KEY"],
    config=botocore.config.Config(request_checksum_calculation="when_required",
                                  response_checksum_validation="when_required",
                                  retries={"max_attempts": TRIES, "mode": "standard"}))


def targets():
    """(recipe folder, file, notices) for each pinned file with a mirror: a model's own and those beside it."""
    for path in sorted(glob.glob(f"{HERE}/workloads/*/manifest.json")):
        with open(path) as f:
            manifest = json.load(f)
        for model in manifest.get("models") or []:
            for item in [model, *(model.get("files") or [])]:
                if item.get("mirror"):
                    yield os.path.dirname(path), item, model.get("notices") or []


def key_of(item):
    key = f"models/{item['sha256']}/{item['name']}"
    if item["mirror"] != f"{PUBLIC}/{key}":
        sys.exit(f"{item['name']}: its mirror isn't {PUBLIC}/{key}")
    return key


def public_size(key):
    """The size of what a node gets at key, with no credential, or None if it gets nothing."""
    request = urllib.request.Request(f"{PUBLIC}/{key}", method="HEAD", headers={"User-Agent": "patai-mirror"})
    try:
        with urllib.request.urlopen(request, timeout=60) as answer:
            return int(answer.headers["Content-Length"])
    except urllib.error.HTTPError as error:
        if error.code in (403, 404):
            return None
        raise


def get(url, start, end):
    request = urllib.request.Request(url, headers={"Range": f"bytes={start}-{end}", "User-Agent": "patai-mirror"})
    for attempt in range(TRIES):
        try:
            with urllib.request.urlopen(request, timeout=120) as answer:
                if answer.status != 206:
                    raise RuntimeError(f"{url} doesn't send part of a file")
                data = answer.read()
            if len(data) == end - start + 1:
                return data
            print(f"  {start}-{end}: {len(data)} bytes, retrying", flush=True)
        except (OSError, RuntimeError) as error:
            if attempt == TRIES - 1:
                raise
            print(f"  retrying {start}-{end}: {error}", flush=True)
    raise RuntimeError(f"{url} kept sending the wrong length")


def open_upload(key):
    """The upload to carry on with, and the parts it has as {number: md5}, or a new one. Any other upload of the
    same key is aborted."""
    found = s3.list_multipart_uploads(Bucket=BUCKET, Prefix=key).get("Uploads") or []
    found = sorted((u for u in found if u["Key"] == key), key=lambda u: u["Initiated"])
    for extra in found[:-1]:
        s3.abort_multipart_upload(Bucket=BUCKET, Key=key, UploadId=extra["UploadId"])
    if not found:
        upload = s3.create_multipart_upload(Bucket=BUCKET, Key=key, ACL="public-read", StorageClass="STANDARD",
                                            ContentType="application/octet-stream")
        return upload["UploadId"], {}
    upload, parts = found[-1]["UploadId"], {}
    for page in s3.get_paginator("list_parts").paginate(Bucket=BUCKET, Key=key, UploadId=upload):
        for part in page.get("Parts") or []:
            parts[part["PartNumber"]] = (part["ETag"].strip('"'), part["Size"])
    return upload, parts


def mirror(item):
    name, size, url, key = item["name"], item["size"], item["url"], key_of(item)
    there = public_size(key)
    if there == size:
        print(f"{name}: there", flush=True)
        return
    if there is not None:
        sys.exit(f"{name}: the bucket holds {there} bytes at {key}, not {size}")
    upload, parts = open_upload(key)
    spans = [(start, min(start + PART, size) - 1) for start in range(0, size, PART)]
    print(f"{name}: {size / 1e9:.2f} GB in {len(spans)} parts from {url}, {len(parts)} uploaded already", flush=True)

    def part(number):
        start, end = spans[number - 1]
        data = get(url, start, end)
        md5 = hashlib.md5(data)
        if parts.get(number) != (md5.hexdigest(), len(data)):
            s3.upload_part(Bucket=BUCKET, Key=key, UploadId=upload, PartNumber=number, Body=data,
                           ContentMD5=base64.b64encode(md5.digest()).decode())
        return data, md5.hexdigest()

    sha256, etags = hashlib.sha256(), []
    with concurrent.futures.ThreadPoolExecutor(AT_ONCE) as pool:
        # At most twice AT_ONCE parts are held at once, as they're hashed in order.
        queue = collections.deque()
        numbers = iter(range(1, len(spans) + 1))
        for number in numbers:
            queue.append(pool.submit(part, number))
            if len(queue) >= 2 * AT_ONCE:
                break
        while queue:
            data, md5 = queue.popleft().result()
            sha256.update(data)
            etags.append(md5)
            for number in numbers:
                queue.append(pool.submit(part, number))
                break
            if len(etags) % 16 == 0 or len(etags) == len(spans):
                print(f"  {len(etags)}/{len(spans)} parts", flush=True)
    if sha256.hexdigest() != item["sha256"]:
        s3.abort_multipart_upload(Bucket=BUCKET, Key=key, UploadId=upload)
        sys.exit(f"{name}: what {url} sent doesn't match its pin, so the upload was aborted")
    s3.complete_multipart_upload(Bucket=BUCKET, Key=key, UploadId=upload, MultipartUpload={
        "Parts": [{"PartNumber": n, "ETag": f'"{etag}"'} for n, etag in enumerate(etags, 1)]})
    if public_size(key) != size:
        sys.exit(f"{name}: {PUBLIC}/{key} doesn't serve it with no credential")
    print(f"{name}: mirrored and matches", flush=True)


def notices(folder, item, names):
    """The model's licence and notices, beside each of its files. These are small and may be corrected, so one
    that differs from the repo's is replaced."""
    prefix = os.path.dirname(key_of(item))
    for name in names:
        with open(os.path.join(folder, name), "rb") as f:
            body = f.read()
        key, md5 = f"{prefix}/{os.path.basename(name)}", hashlib.md5(body)
        try:
            if s3.head_object(Bucket=BUCKET, Key=key)["ETag"].strip('"') == md5.hexdigest():
                continue
        except s3.exceptions.ClientError as error:
            if error.response["Error"]["Code"] not in ("404", "NoSuchKey"):
                raise
        s3.put_object(Bucket=BUCKET, Key=key, Body=body, ACL="public-read", StorageClass="STANDARD",
                      ContentType="text/plain; charset=utf-8", ContentMD5=base64.b64encode(md5.digest()).decode())
        if public_size(key) != len(body):
            sys.exit(f"{PUBLIC}/{key} doesn't serve it with no credential")
        print(f"  {key}", flush=True)


def main():
    wanted = set(sys.argv[1:])
    chosen = [t for t in targets() if not wanted or t[1]["name"] in wanted]
    missing = wanted - {item["name"] for _, item, _ in chosen}
    if missing:
        sys.exit(f"Not pinned with a mirror: {' '.join(sorted(missing))}")
    for folder, item, names in chosen:
        mirror(item)
        notices(folder, item, names)
    listing = urllib.request.Request(f"{PUBLIC}/?prefix=models/", headers={"User-Agent": "patai-mirror"})
    try:
        urllib.request.urlopen(listing, timeout=60)
        sys.exit(f"{PUBLIC} can be listed")
    except urllib.error.HTTPError as error:
        if error.code != 403:
            raise


main()
