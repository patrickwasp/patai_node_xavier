#!/usr/bin/env bash
# Publish ready-built images to GitHub's container registry, so a node pulls them and never compiles. Takes each image
# from a node that built it, pushes it to ghcr.io, and pins it in every manifest that runs it: the reference, the
# digest a node pulls by, the image ID it checks, the size of each layer, so the console can say how far a pull has
# got, and the size unpacked, which a node needs room for.
#
#   scripts/publish-workloads [name...]      default: the shared CUDA base, then every recipe with a Dockerfile
#
# The CUDA base (workloads/cuda-base) has no manifest: publishing it rewrites the FROM line of each recipe built on
# it, which then needs building again. Needs `gh` logged in with write:packages; its token is used for the push only,
# from a Docker config on tmpfs that's deleted after. Then commit the manifests and build a new OS release: the recipes
# ship in it, so the signed OS update is what vouches for these images.
#
# skopeo pushes what `docker save` gives with each layer compressed with zstd, which Docker pulls since 23. A layer
# pushed once is reused by every image that has it, so the base is downloaded once. zstd needs an OCI manifest, so
# skopeo writes the config again as OCI's, and its digest is the ID a node gets when it pulls. That leaves out what OCI
# has no field for, so an image whose config would lose something that changes how it runs, such as a health check,
# is refused. A recipe that wants one has it in its compose.yaml, where Docker keeps it.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

skopeo=quay.io/skopeo/stable:v1.24.1@sha256:9fdeeda2801cf93a0a15bfb2154e44a0c5a0f3650e54586165bd1b732e503702

[[ $# -gt 0 ]] || set -- cuda-base $(cd "$repo/workloads" && for d in */; do
  [[ -f $d/Dockerfile && -f $d/manifest.json ]] && echo "${d%/}"; done)

config=$(mktemp -d -p /dev/shm patai-docker.XXXXXX)
work=$(mktemp -d -p "${TMPDIR:-/var/tmp}" patai-publish.XXXXXX)
trap 'rm -rf "$config" "$work"' EXIT
gh auth token | python3 -I -c 'import base64, json, sys
auth = base64.b64encode(f"{sys.argv[1]}:{sys.stdin.read().strip()}".encode()).decode()
with open(sys.argv[2], "w") as f:
    json.dump({"auths": {"ghcr.io": {"auth": auth}}}, f)' "$(gh api user --jq .login)" "$config/config.json"
# Its cache says which layers ghcr.io already has, as zstd, so they aren't compressed and sent again.
run_skopeo() {
  docker run --rm -v "$work:/work" -v "$config:/auth:ro" -v patai-skopeo-cache:/var/lib/containers/cache "$skopeo" \
    "$@" --authfile /auth/config.json
}
on_node() { "$repo/scripts/ssh" -o BatchMode=yes -o LogLevel=ERROR "$@" </dev/null; }

for name in "$@"; do
  if [[ $name == cuda-base ]]; then
    ref=$cuda_base
  else
    ref=$(python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1]))["image"]["ref"])' \
      "$repo/workloads/$name/manifest.json")
  fi
  [[ $ref == ghcr.io/*:* ]] || { echo "$name: $ref isn't a ghcr.io reference with a tag" >&2; exit 1; }
  # The bench labels its test containers patai.test to find and remove them by. An image built with the label passes
  # it to every container run from it, so a node's servers would look like tests.
  labels=$(on_node "docker image inspect --format '{{json .Config.Labels}}' $ref")
  if grep -q '"patai\.test"' <<< "$labels"; then
    echo "$name: $ref has the label patai.test, which is only for bench containers. Rebuild it" >&2
    exit 1
  fi
  built=$(on_node "docker image inspect --format '{\"config\": {{json .Config}}, \"layers\": {{json .RootFS.Layers}}, \"size\": {{.Size}}}' $ref")
  on_node "docker save $ref" > "$work/image.tar"
  # Forced, or skopeo reuses a layer ghcr.io has in another compression, or none.
  run_skopeo copy -q --format oci --dest-compress-format zstd --dest-compress-level 19 --dest-force-compress-format \
    --digestfile /work/digest docker-archive:/work/image.tar "docker://$ref"
  rm "$work/image.tar"
  digest=$(cat "$work/digest")
  raw=$(run_skopeo inspect --raw "docker://${ref%:*}@$digest")
  pushed=$(run_skopeo inspect --config "docker://${ref%:*}@$digest")
  pin=$(python3 -I - "$name" "$built" "$raw" "$pushed" <<'PY'
import json, sys
name, built, raw, pushed = sys.argv[1], *map(json.loads, sys.argv[2:])
was, now = built["config"], pushed.get("config") or {}
lost = [key for key in ("Entrypoint", "Cmd", "Env", "WorkingDir", "User", "Labels", "ExposedPorts", "Volumes",
                        "StopSignal") if (was.get(key) or None) != (now.get(key) or None)]
# NONE is what OCI's lack of the field gives anyway.
if (was.get("Healthcheck") or {}).get("Test") not in (None, [], ["NONE"]):
    lost.append("Healthcheck")
if pushed["rootfs"]["diff_ids"] != built["layers"]:
    lost.append("its layers")
if any(not layer["mediaType"].endswith("+zstd") for layer in raw["layers"]):
    lost.append("zstd")
if lost:
    sys.exit(f"{name}: what was pushed isn't what the node built: {', '.join(lost)}")
print(raw["config"]["digest"], built["size"])
PY
)
  read -r id unpacked <<< "$pin"
  if [[ $name == cuda-base ]]; then
    sed -i "s|${ref%:*}@sha256:[0-9a-zA-Z_]*|${ref%:*}@$digest|" "$repo"/workloads/*/Dockerfile
    echo "$name: $ref@$digest; rebuild what's built on it"
    continue
  fi
  python3 -I - "$repo/workloads" "$ref" "$digest" "$id" "$unpacked" "$raw" <<'PY'
import glob, json, re, sys
workloads, ref, digest, image_id, unpacked, raw = sys.argv[1:]
layers = [{"digest": layer["digest"], "size": layer["size"]} for layer in json.loads(raw)["layers"]]
new = {"ref": ref, "digest": digest, "id": image_id, "size": sum(layer["size"] for layer in layers),
       "unpacked": int(unpacked), "layers": layers}


def dump(manifest):
    """The manifests' layout: short lists and objects on one line."""
    text = json.dumps(manifest, indent=2, ensure_ascii=False)

    def flatten(match):
        inner = match.group(0)
        flat = re.sub(r"\s*\n\s*", " ", inner).replace("[ ", "[").replace(" ]", "]").replace("{ ", "{").replace(" }", "}")
        return flat if len(flat) < 100 else inner
    text = re.sub(r"\[[^\[\]{}]*\]", flatten, text)
    text = re.sub(r"\{[^\[\]{}]*\}", flatten, text)
    return text + "\n"


# Every recipe that runs this image: its own, and those without a Dockerfile.
for path in sorted(glob.glob(f"{workloads}/*/manifest.json")):
    with open(path) as f:
        manifest = json.load(f)
    if manifest.get("image", {}).get("ref") != ref:
        continue
    manifest["image"] = new
    with open(path, "w") as f:
        f.write(dump(manifest))
print(f"{ref}: {new['size'] / 1e6:.0f} MB to pull, {int(unpacked) / 1e6:.0f} MB unpacked, {len(layers)} layers")
PY
done
