#!/usr/bin/env bash
# Sign a RAUC bundle around the image scripts/build-product made: out/<version>/patai-<version>.raucb.
#
#   PATAI_RAUC_KEYS=<dir> scripts/build-bundle <version>
#
# <dir> holds the fleet's signing key.pem and cert.pem (scripts/new-fleet-key). Neither belongs in the repo or an image:
# keep them in a secret store, and in a folder on tmpfs only while they sign.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

version=${1:?usage: scripts/build-bundle <version>}
out=$(product_dir "$version")
[[ -f $out/rootfs.ext4 ]] || { echo "No $out/rootfs.ext4; run scripts/build-product $version." >&2; exit 2; }
build_rauc amd64
[[ -f ${PATAI_RAUC_KEYS:-}/key.pem && -f $PATAI_RAUC_KEYS/cert.pem ]] \
  || { echo "PATAI_RAUC_KEYS has to name a folder holding the signing key.pem and cert.pem." >&2; exit 2; }

keys=$(mktemp -d -p /dev/shm patai-bundle.XXXXXX)
input=$(mktemp -d -p "$out" bundle.XXXXXX)
trap 'rm -rf "$keys" "$input"' EXIT
cp "$PATAI_RAUC_KEYS"/key.pem "$PATAI_RAUC_KEYS"/cert.pem "$keys/"

install -m 755 "$repo/bundle/hook" "$input/hook"
install -m 644 "$repo/console/STATE_FORMAT" "$input/state-format"
cat > "$input/manifest.raucm" <<MANIFEST
[update]
compatible=patai-node-xavier
version=$version

[bundle]
format=verity

[hooks]
filename=hook
hooks=install-check

[image.rootfs]
filename=rootfs.ext4
hooks=post-install
MANIFEST

bundle=patai-$version.raucb
rm -f "$out/$bundle"
# The image is root's, so only a root container may link it into the input directory.
docker run --rm -v "$out:/work" -v "$keys:/keys:ro" "$(rauc_image amd64)" sh -ec "
  ln /work/rootfs.ext4 /work/${input##*/}/rootfs.ext4
  exec /out/usr/bin/rauc bundle --cert=/keys/cert.pem --key=/keys/key.pem /work/${input##*/} /work/$bundle"
ls -la "$out/$bundle"
echo "Offer it on a channel with scripts/sign-latest <channel> $version."
